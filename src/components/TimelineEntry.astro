---
import type { TimelineItem } from '~/lib/timeline';
import { formatPeriod, lanes } from '~/lib/timeline';
import Placeholder from './Placeholder.astro';

interface Props { item: TimelineItem; showLane?: boolean }
const { item, showLane = false } = Astro.props;
const period = formatPeriod(item);
const laneLabel = lanes.find((l) => l.id === item.lane)?.label;
const laneBorder = { education: 'border-teal', industry: 'border-clay', research: 'border-sage-deep' }[item.lane];
---
<div id={item.anchor ?? item.id} class:list={['h-full scroll-mt-24 border-l-2 pl-4', laneBorder, item.highlight && 'bg-paper-deep py-3 pr-4']}>
  <p class="eyebrow">
    {showLane && <span class="md:hidden">{laneLabel} · </span>}
    {period ?? <span class="todo normal-case tracking-normal">[Dates to be added]</span>}
  </p>
  <h3 class="font-display mt-2 text-xl" style="line-height:1.2">{item.title}</h3>
  <p class="mt-1 text-sm text-ink-soft">
    {item.org ?? <Placeholder>Institution or organization to be added</Placeholder>}
  </p>
  {item.detail && <p class="mt-1 text-sm text-ink-soft">{item.detail}</p>}
  {item.summary && <p class="mt-3 text-sm text-ink-soft">{item.summary}</p>}
  {item.topics.length > 0 && <p class="mt-3 text-sm">{item.topics.join(' · ')}</p>}
  {item.href && <p class="mt-3 text-sm"><a href={item.href} class="link-line">Details →</a></p>}
  {item.related.length > 0 && (
    <p class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm">
      {item.related.map((r) => <a href={`/projects/${r.slug}`} class="link-line">{r.title}</a>)}
    </p>
  )}
</div>
