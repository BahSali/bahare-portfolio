---
import type { TimelineItem } from '~/lib/timeline';
import { formatPeriod, lanes } from '~/lib/timeline';
import Placeholder from './Placeholder.astro';

interface Props { item: TimelineItem; showLane?: boolean }
const { item, showLane = false } = Astro.props;
const period = formatPeriod(item);
const laneLabel = lanes.find((l) => l.id === item.lane)?.label;
const laneBorder = { education: 'border-teal', industry: 'border-clay', research: 'border-sage-deep' }[item.lane];
---
<div id={item.anchor ?? item.id} class="grid scroll-mt-24 gap-x-10 gap-y-2 md:grid-cols-[11rem_1fr]">
  <p class="text-sm tabular-nums text-ink-soft">
    {period ?? <span class="todo">[Dates to be added]</span>}
  </p>
  <div class:list={['border-l-2 pl-4', laneBorder]}>
    {showLane && <p class="eyebrow">{laneLabel}</p>}
    <h3 class="font-display mt-1 text-xl" style="line-height:1.2">{item.title}</h3>
    <p class="mt-1 text-sm text-ink-soft">
      {item.org ?? <Placeholder>Institution or organization to be added</Placeholder>}
      {item.detail && <> · {item.detail}</>}
    </p>
    {item.summary && <p class="mt-2 max-w-[42rem] text-sm text-ink-soft">{item.summary}</p>}
    {item.topics.length > 0 && <p class="mt-2 text-sm">{item.topics.join(' · ')}</p>}
    {(item.href || item.related.length > 0) && (
      <p class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-sm">
        {item.href && <a href={item.href} class="link-line">Details →</a>}
        {item.related.map((r) => <a href={`/projects/${r.slug}`} class="link-line">{r.title}</a>)}
      </p>
    )}
  </div>
</div>
