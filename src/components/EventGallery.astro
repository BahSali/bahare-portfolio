---
import { Image, getImage } from 'astro:assets';
import type { ResearchEvent } from '~/data/events';
import PlaceholderBlock from './PlaceholderBlock.astro';

/**
 * Gallery of research events. Each event has a short caption and a grid of small, uniform thumbnails;
 * clicking a thumbnail opens the full photograph in a lightbox. Any number of photos per event works.
 */
interface Props { events: ResearchEvent[] }
const { events } = Astro.props;
const withBig = await Promise.all(
  events.map(async (e) => ({
    ...e,
    photos: await Promise.all(
      e.photos.map(async (p) => ({ ...p, big: (await getImage({ src: p.src, width: Math.min(p.src.width, 2000), format: 'jpg' })).src })),
    ),
  })),
);
---
{events.length === 0
  ? <PlaceholderBlock>Event photographs, titles, locations and short descriptions to be added in src/data/events.ts</PlaceholderBlock>
  : (
    <ol class="divide-y divide-warm/50">
      {withBig.map((e) => {
        const n = e.photos.length;
        return (
          <li class="grid gap-x-10 gap-y-4 py-8 first:pt-0 last:pb-0 md:grid-cols-[8.5rem_1fr]">
            <div>
              {e.year && <p class="font-display text-2xl text-clay" style="line-height:1">{e.year}</p>}
              <p class="eyebrow mt-2">{e.kind}</p>
              {e.location && <p class="mt-1 text-[0.8125rem] leading-snug text-ink-soft">{e.location}</p>}
            </div>
            <div class="grid gap-x-8 gap-y-4 lg:grid-cols-[minmax(0,1fr)_minmax(0,22rem)] lg:items-start">
              <div>
                <h3 class="font-display text-xl" style="line-height:1.25">{e.title}</h3>
                {e.subtitle && <p class="mt-1 text-sm italic leading-snug text-ink-soft">{e.subtitle}</p>}
                <p class="mt-3 max-w-[34rem] text-[0.9375rem] leading-[1.65] text-ink-soft">{e.involvement}</p>
                {e.link && <p class="mt-3 text-sm"><a href={e.link.href} class="link-line" target="_blank" rel="noopener noreferrer">{e.link.label} →</a></p>}
              </div>
              <ul class:list={['grid gap-1.5', n === 1 ? 'grid-cols-1' : 'grid-cols-3 grid-rows-2']}>
                {e.photos.slice(0, 3).map((p, i) => (
                  <li class:list={[n >= 3 && i === 0 && 'col-span-2 row-span-2', n === 2 && 'col-span-3 row-span-1 first:col-span-2']}>
                    <button type="button" data-lightbox={p.big} data-alt={p.alt} class:list={['group relative block w-full cursor-zoom-in overflow-hidden bg-paper-deep', n === 1 ? 'aspect-[3/2]' : n >= 3 ? 'aspect-auto h-full min-h-[5.5rem]' : 'aspect-[4/3]']} aria-label={`Enlarge photo: ${p.alt}`}>
                      <Image src={p.src} alt={p.alt} width={n >= 3 && i === 0 ? 700 : 420} height={n >= 3 && i === 0 ? 525 : 315} class="h-full w-full object-cover transition duration-500 ease-out group-hover:scale-[1.04]" loading="lazy" />
                      <span aria-hidden="true" class="absolute inset-0 bg-ink/0 transition-colors duration-300 group-hover:bg-ink/10"></span>
                    </button>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        );
      })}
    </ol>
    <dialog id="gallery-lightbox" class="m-auto max-h-[92vh] max-w-[min(96vw,64rem)] bg-paper p-3 backdrop:bg-ink/70">
      <form method="dialog" class="mb-2 text-right"><button class="text-sm underline underline-offset-4">Close</button></form>
      <img id="gallery-lightbox-img" alt="" class="h-auto max-h-[80vh] w-full object-contain" />
    </dialog>
  )}

<script>
  const lb = document.getElementById('gallery-lightbox') as HTMLDialogElement | null;
  const img = document.getElementById('gallery-lightbox-img') as HTMLImageElement | null;
  if (lb && img) {
    document.querySelectorAll<HTMLButtonElement>('#events [data-lightbox]').forEach((b) =>
      b.addEventListener('click', () => { img.src = b.dataset.lightbox!; img.alt = b.dataset.alt ?? ''; lb.showModal(); }),
    );
    lb.addEventListener('click', (e) => { if (e.target === lb) lb.close(); });
  }
</script>
