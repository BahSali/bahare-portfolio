---
import { Image } from 'astro:assets';
import type { ResearchEvent } from '~/data/events';
import PlaceholderBlock from './PlaceholderBlock.astro';

/** Photographic gallery of research events: a lead photograph with up to two more beside it, caption underneath. */
interface Props { events: ResearchEvent[] }
const { events } = Astro.props;
const frame = 'group overflow-hidden bg-paper-deep';
const img = 'h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.02]';
---
{events.length === 0
  ? <PlaceholderBlock>Event photographs, titles, locations and short descriptions to be added in src/data/events.ts</PlaceholderBlock>
  : (
    <ul class="space-y-14">
      {events.map((e) => {
        const [lead, ...rest] = e.photos;
        return (
          <li>
            <div class:list={['grid gap-3', rest.length > 0 && 'md:grid-cols-12']}>
              {lead && (
                <div class:list={[frame, 'aspect-[4/3]', rest.length > 0 && 'md:col-span-7 md:aspect-auto md:min-h-full']}>
                  <Image src={lead.src} alt={lead.alt} width={1200} class={img} loading="lazy" />
                </div>
              )}
              {rest.length > 0 && (
                <div class="grid gap-3 md:col-span-5 md:grid-rows-2">
                  {rest.slice(0, 2).map((p) => (
                    <div class:list={[frame, 'aspect-[3/2] md:aspect-auto md:h-full']}>
                      <Image src={p.src} alt={p.alt} width={800} class={img} loading="lazy" />
                    </div>
                  ))}
                </div>
              )}
            </div>
            <div class="mt-4 max-w-[44rem]">
              <p class="eyebrow">{[e.kind, e.year, e.location].filter(Boolean).join(' · ')}</p>
              <h3 class="font-display mt-1.5 text-xl" style="line-height:1.25">{e.title}</h3>
              {e.subtitle && <p class="mt-1 text-sm italic text-ink-soft">{e.subtitle}</p>}
              <p class="mt-2 text-[0.9375rem] leading-[1.65] text-ink-soft">{e.involvement}</p>
              {e.link && <p class="mt-2 text-sm"><a href={e.link.href} class="link-line" target="_blank" rel="noopener noreferrer">{e.link.label}</a></p>}
            </div>
          </li>
        );
      })}
    </ul>
  )}
