---
import { site } from '~/data/site';
import Placeholder from './Placeholder.astro';

const c = site.contact;
const links = [
  { label: 'Email', href: c.email ? `mailto:${c.email}` : null, text: c.email },
  { label: 'CV', href: c.cvUrl, text: 'Download CV (PDF)' },
  { label: 'LinkedIn', href: c.linkedin, text: 'LinkedIn' },
  { label: 'GitHub', href: c.github, text: 'GitHub' },
  { label: 'Google Scholar', href: c.scholar, text: 'Google Scholar' },
  { label: 'ORCID', href: c.orcid, text: 'ORCID' },
];
---
<dl class="divide-y divide-warm/70 border-y border-warm/70">
  {links.map((l) => (
    <div class="grid grid-cols-[8.5rem_1fr] items-baseline gap-4 py-3.5 sm:grid-cols-[11rem_1fr]">
      <dt class="eyebrow">{l.label}</dt>
      <dd>
        {l.href
          ? <a href={l.href} class="link-line">{l.text}</a>
          : <Placeholder>{l.label} link to be added</Placeholder>}
      </dd>
    </div>
  ))}
</dl>
