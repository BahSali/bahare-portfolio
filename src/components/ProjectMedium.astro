---
import type { Project } from '~/data/projects';
import { categoryLabels } from '~/data/projects';
import ImagePlaceholder from './ImagePlaceholder.astro';

interface Props { project: Project; tone?: 'sage' | 'warm' | 'teal' }
const { project, tone = 'warm' } = Astro.props;
const href = `/projects/${project.slug}`;
---
<article class="group grid items-center gap-6 md:grid-cols-12 md:gap-10">
  <a href={href} tabindex="-1" aria-hidden="true" class="block overflow-hidden md:col-span-5">
    <div class="transition-transform duration-700 ease-out group-hover:scale-[1.015]">
      <ImagePlaceholder src={project.image.src} alt={project.image.alt} label={project.image.placeholderLabel} tone={tone} ratio="aspect-[4/3]" />
    </div>
  </a>
  <div class="md:col-span-6 md:col-start-7">
    <p class="eyebrow">{categoryLabels[project.category]}</p>
    <h3 class="font-display-tight mt-3 text-2xl font-normal" style="line-height:1.15">
      <a href={href} class="transition-colors hover:text-teal">{project.title}</a>
    </h3>
    <p class="mt-3 text-ink-soft">{project.summary}</p>
    <p class="mt-4 text-sm"><a href={href} class="link-line">View project →</a></p>
  </div>
</article>
