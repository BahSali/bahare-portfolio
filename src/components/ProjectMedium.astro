---
import type { Project } from '~/data/projects';
import { categoryLabels } from '~/data/projects';
import ImagePlaceholder from './ImagePlaceholder.astro';

interface Props { project: Project; tone?: 'sage' | 'warm' | 'teal' }
const { project, tone = 'warm' } = Astro.props;
---
<a href={`/projects/${project.slug}`} class="group grid items-center gap-4 sm:grid-cols-12 sm:gap-8">
  <div class="overflow-hidden sm:col-span-4">
    <div class="transition-transform duration-500 ease-out group-hover:scale-[1.03] [&_span.font-display]:text-base">
      <ImagePlaceholder src={project.image.src} alt={project.image.alt} label={project.image.placeholderLabel} tone={tone} ratio="aspect-[16/10]" />
    </div>
  </div>
  <div class="sm:col-span-7 sm:col-start-6">
    <p class="eyebrow">{categoryLabels[project.category]}</p>
    <h3 class="font-display mt-2 text-xl leading-snug transition-colors group-hover:text-teal group-focus-visible:text-teal sm:text-2xl">{project.title}</h3>
    <p class="mt-2 max-w-[34rem] text-sm text-ink-soft">{project.summary}</p>
    <p class="mt-3 text-sm text-ink-soft transition-colors group-hover:text-clay">
      View project <span aria-hidden="true" class="inline-block transition-transform duration-300 group-hover:translate-x-1">→</span>
    </p>
  </div>
</a>
