---
import type { Project } from '~/data/projects';
import { categoryLabels } from '~/data/projects';
import ImagePlaceholder from './ImagePlaceholder.astro';

/** Compact, fully clickable project card for overview grids (e.g. Home). */
interface Props { project: Project; tone?: 'sage' | 'warm' | 'teal' }
const { project, tone = 'sage' } = Astro.props;
---
<a
  href={`/projects/${project.slug}`}
  class="group flex gap-4 transition-colors md:flex-col md:gap-5"
>
  <div class="w-[40%] shrink-0 overflow-hidden md:w-full">
    <div class="transition-transform duration-500 ease-out group-hover:scale-[1.03] max-md:[&_span.font-display]:hidden md:[&_span.font-display]:text-base">
      <ImagePlaceholder
        src={project.image.src}
        alt={project.image.alt}
        label={project.image.placeholderLabel}
        tone={tone}
        ratio="aspect-[4/3]"
      />
    </div>
  </div>
  <div class="min-w-0 self-center md:self-auto">
    <p class="eyebrow">{categoryLabels[project.category]}</p>
    <h3 class="font-display mt-2 text-lg leading-snug transition-colors group-hover:text-teal group-focus-visible:text-teal sm:text-xl">
      {project.title}
    </h3>
    <p class="mt-3 text-sm text-ink-soft transition-colors group-hover:text-clay">
      View project <span aria-hidden="true" class="inline-block transition-transform duration-300 group-hover:translate-x-1">→</span>
    </p>
  </div>
</a>
