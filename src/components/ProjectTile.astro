---
import type { CardItem } from '~/data/projects';
import ImagePlaceholder from './ImagePlaceholder.astro';

/** Compact, fully clickable card for overview grids (projects or experience items). */
interface Props { item: CardItem; tone?: 'sage' | 'warm' | 'teal'; variant?: 'compact' | 'lead'; minimal?: boolean }
const { item, tone = 'sage', variant = 'compact', minimal = false } = Astro.props;
const lead = variant === 'lead';
---
<a
  href={item.href}
  class:list={['group flex transition-colors', lead ? 'flex-col gap-4' : 'gap-4 md:flex-col md:gap-5']}
>
  <div class:list={['overflow-hidden', lead ? 'w-full' : 'w-[40%] shrink-0 md:w-full']}>
    <div class:list={['transition-transform duration-500 ease-out group-hover:scale-[1.03]', lead ? '[&_span.font-display]:text-base' : 'max-md:[&_span.font-display]:hidden md:[&_span.font-display]:text-base']}>
      <ImagePlaceholder
        src={item.image.src}
        alt={item.image.alt}
        label={item.image.placeholderLabel}
        tone={tone}
        ratio={lead ? 'aspect-[16/10]' : 'aspect-[16/9]'}
      />
    </div>
  </div>
  <div class="min-w-0 self-center md:self-auto">
    <p class="eyebrow">{item.label}</p>
    <h3 class:list={['font-display mt-2 leading-snug transition-colors group-hover:text-teal group-focus-visible:text-teal', lead ? 'text-xl sm:text-2xl' : 'text-lg sm:text-xl']}>
      {item.title}
    </h3>
    <p class:list={['mt-2 text-ink-soft', lead ? 'max-w-[34rem] text-sm' : 'text-[0.8125rem] leading-snug']}>{item.summary}</p>
    {item.demo && !minimal && <p class="mt-2.5 flex text-xs"><span class="border border-clay/60 bg-clay/10 px-2 py-0.5 text-clay">Live demo</span></p>}
    {!minimal && (
      <p class="mt-3 text-sm text-ink-soft transition-colors group-hover:text-clay">
        {item.cta ?? 'View project'} <span aria-hidden="true" class="inline-block transition-transform duration-300 group-hover:translate-x-1">→</span>
      </p>
    )}
  </div>
</a>
