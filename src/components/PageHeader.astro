---
import Container from './Container.astro';
interface Props { eyebrow: string; title: string }
const { eyebrow, title } = Astro.props;
---
<Container class="pt-section-sm">
  <div class="grid gap-6 lg:grid-cols-12">
    <div class="lg:col-span-9">
      <p class="eyebrow mb-4">{eyebrow}</p>
      <h1 class="font-display-tight text-[clamp(2.5rem,7vw,5rem)] font-light">{title}</h1>
    </div>
    <div class="max-w-xl text-lg text-ink-soft lg:col-span-7"><slot /></div>
  </div>
</Container>
