---
import Container from './Container.astro';
interface Props { eyebrow: string; title: string }
const { eyebrow, title } = Astro.props;
---
<Container class="pt-10 sm:pt-14">
  <div class="grid gap-6 lg:grid-cols-12">
    <div class="lg:col-span-9">
      <p class="eyebrow mb-3">{eyebrow}</p>
      <h1 class="font-display-tight text-[clamp(1.75rem,3.2vw,2.5rem)] font-light">{title}</h1>
    </div>
    <div class="max-w-xl text-ink-soft lg:col-span-7"><slot /></div>
  </div>
</Container>
