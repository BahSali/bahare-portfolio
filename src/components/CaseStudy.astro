---
import type { Project, ProjectStory } from '~/data/projects';
import { publications } from '~/data/publications';
import { emeralds } from '~/data/emeralds';
import Container from './Container.astro';
import { Image, getImage } from 'astro:assets';
import ImagePlaceholder from './ImagePlaceholder.astro';

/** Long-form layout for a project with a `story` (see ProjectStory in data/projects.ts). */
interface Props { project: Project; story: ProjectStory }
const { project, story } = Astro.props;
const app = project.application;
const shots = (app?.screenshots ?? []).filter((x) => x.src);

const refs = publications
  .filter((p) => project.publications.includes(p.slug))
  .sort((a, b) => b.year - a.year);

const withBig = (figs: any[]) =>
  Promise.all(figs.map(async (f) => ({
    ...f,
    big: (await getImage({ src: f.src, width: Math.min(f.src.width, 1800), format: f.src.src.endsWith('.png') ? 'png' : 'webp', quality: 'high' })).src,
  })));
const dsFull = await Promise.all(story.datasets.map(async (d) => ({
  ...d,
  sections: await Promise.all(d.sections.map(async (sec) => ({
    ...sec,
    figures: await withBig(sec.figures),
    groups: sec.groups ? await Promise.all(sec.groups.map(async (g) => ({ ...g, figures: await withBig(g.figures) }))) : undefined,
  }))),
})));

const archBig = await Promise.all(story.architectures.map(async (a) => ({
  ...a,
  big: (await getImage({ src: a.src, width: Math.min(a.src.width, 2000), format: 'png' })).src,
})));

const band = 'scroll-mt-28 border-t border-ink/25';
const tint = 'bg-[#dbe2d3]';
const pad = 'py-8 sm:py-12';
const h2 = 'font-display-tight mb-5 text-3xl font-light sm:mb-5 sm:text-[2.1rem]';
const h3 = 'font-display text-lg';
---
<!-- Overview -->
<section id="overview" class={band}>
  <Container class="py-6 sm:py-9">
    <h2 class="font-display-tight mb-4 text-3xl font-light sm:text-[2.1rem]">Overview</h2>
    <div class="grid items-start gap-6 lg:grid-cols-12 lg:gap-10">
      <div class="max-w-[36rem] space-y-3.5 text-base leading-[1.65] lg:col-span-7 text-justify hyphens-auto">
        {story.overview.map((p) => <p>{p}</p>)}
      </div>
      {story.overviewMedia && (
        <figure class="lg:col-span-5 lg:max-w-[26rem]">
          <picture>
            <source media="(prefers-reduced-motion: reduce)" srcset={story.overviewMedia.still} />
            <img
              src={story.overviewMedia.src}
              alt={story.overviewMedia.alt}
              width={story.overviewMedia.width}
              height={story.overviewMedia.height}
              loading="lazy"
              decoding="async"
              class="h-auto w-full border border-warm/60"
            />
          </picture>
          <figcaption class="mt-2 text-sm text-ink-soft">{story.overviewMedia.caption}</figcaption>
        </figure>
      )}
    </div>
    <dl class="mt-6 grid gap-4 border-y border-warm/70 py-4 sm:grid-cols-3 sm:gap-8">
      {story.facts.map((f) => (
        <div>
          <dt class="font-display-tight text-2xl font-light text-teal sm:text-3xl">{f.value}</dt>
          <dd class="mt-1 text-sm text-ink-soft">{f.label}</dd>
        </div>
      ))}
    </dl>
  </Container>
</section>

<!-- Research journey -->
<section id="journey" class:list={[band, tint]}>
  <Container class={pad}>
    <h2 class={h2}>Research Journey</h2>
    <ol class="grid gap-9 lg:grid-cols-5 lg:gap-x-0">
      {story.journey.map((s, i) => {
        const ongoing = s.status === 'ongoing';
        return (
          <li class:list={['relative border-l pl-6 lg:border-l-0 lg:border-t lg:pl-0 lg:pr-6 lg:pt-6', ongoing ? 'border-dashed border-ink/50' : 'border-ink']}>
            <span aria-hidden="true" class:list={['absolute -left-[5px] top-1.5 size-[9px] rounded-full lg:left-0 lg:-top-[5px]', ongoing ? 'border border-ink/60 bg-paper' : 'bg-clay']}></span>
            <p class="font-display text-sm text-clay">
              0{i + 1}
              {ongoing && <span class="ml-2 font-sans text-xs italic text-ink-soft">In progress</span>}
            </p>
            <h3 class="font-display mt-1 text-lg" style="line-height:1.25">{s.title}</h3>
            <p class="mt-3 max-w-xl text-[0.95rem] text-ink-soft lg:text-sm">
              <span class="lg:hidden">{s.text}</span><span class="hidden lg:inline">{s.short}</span>
            </p>
            {s.topics && <p class="mt-3 text-sm">{s.topics.join(' · ')}</p>}
            {(s.details.length > 0 || s.papers.length > 0 || s.features) && (
              <div class="mt-4 space-y-1.5 border-t border-warm/60 pt-3 text-sm text-ink-soft lg:text-[0.8125rem]">
                {s.details.map((d) => <p><span class="eyebrow mr-2">{d.label}</span>{d.text}</p>)}
                {s.features && <p><span class="eyebrow mr-2">Features</span>{s.features}{app && <> · <a href="#application" class="link-line">See the application ↓</a></>}</p>}
                {s.papers.length > 0 && (
                  <p>
                    <span class="eyebrow mr-2">{s.papers.length > 1 ? 'Publications' : 'Publication'}</span>
                    {s.papers.map((pp, k) => <>{k > 0 && ' · '}<a href={`/research#pub-${pp.slug}`} class="link-line">{pp.label}</a></>)}
                  </p>
                )}
              </div>
            )}
            {ongoing && <p class="mt-3 text-sm"><a href="#current-research" class="link-line">Current research ↓</a></p>}
          </li>
        );
      })}
    </ol>
  </Container>
</section>

<!-- Data -->
<section id="data" class={band}>
  <Container class={pad}>
    <h2 class={h2}>Data</h2>
    <p class="mb-8 text-[1.0625rem] leading-[1.7]">{story.dataIntro}</p>

    <ul class="grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-3 lg:grid-cols-5" id="dataset-gallery">
      {story.datasets.map((d) => (
        <li>
          <article data-card={d.id} class="group h-full border border-transparent">
            <div class="aspect-[4/3] overflow-hidden border border-warm/60 bg-white">
              <Image src={d.card.src} alt={d.card.alt} format="webp" quality="high" width={760} style={d.card.position ? `object-position:${d.card.position}` : undefined} class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]" loading="lazy" />
            </div>
            <p class="eyebrow mt-3 !text-[0.6875rem] !tracking-[0.1em]">{d.kind}</p>
            <h3 class="font-display mt-1 text-lg" style="line-height:1.2">{d.name}</h3>
            <p class="mt-2 text-[0.8125rem] leading-relaxed text-ink-soft">
              {d.roleLink && d.role.includes(d.roleLink.text)
                ? <>{d.role.split(d.roleLink.text)[0]}<a href={d.roleLink.href} class="link-line">{d.roleLink.text}</a>{d.role.split(d.roleLink.text)[1]}</>
                : d.role}
            </p>
            <button
              type="button"
              data-open={d.id}
              aria-expanded="false"
              aria-controls={`panel-${d.id}`}
              class="mt-3 inline-flex items-center gap-2 border border-ink/40 px-3 py-1.5 text-[0.8125rem] transition-colors hover:bg-ink hover:text-paper aria-expanded:border-ink aria-expanded:bg-ink aria-expanded:text-paper"
            >
              <span data-label>Show more</span>
              <span aria-hidden="true" data-chevron>↓</span>
            </button>
          </article>
        </li>
      ))}
    </ul>

    <div id="dataset-panels" class="mt-6">
      {dsFull.map((d) => (
        <section id={`panel-${d.id}`} data-panel={d.id} hidden class="scroll-mt-32 border border-ink/40 bg-[#f4f1ea]" aria-labelledby={`panel-${d.id}-h`}>
          <header class="flex items-center justify-between gap-4 border-b border-ink/25 bg-paper-deep px-5 py-3">
            <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
              <h3 id={`panel-${d.id}-h`} class="font-display text-xl" style="line-height:1.2">{d.name}</h3>
              <p class="eyebrow">{d.kind}</p>
            </div>
            <button type="button" data-close class="shrink-0 text-sm underline underline-offset-4">Close</button>
          </header>

          <div class="grid gap-0 lg:grid-cols-12">
            <aside class="border-b border-ink/25 lg:col-span-4 lg:border-b-0 lg:border-r"><div class="p-5 lg:sticky lg:top-36">
              <h4 class="eyebrow mb-2">Overview</h4>
              {d.refined
                ? (
                  <dl class="space-y-3 text-[0.8125rem]">
                    {d.overview.map((o) => (
                      <div>
                        <dt class="text-[0.6875rem] uppercase tracking-[0.12em] text-ink-soft/80">{o.label}</dt>
                        <dd class="mt-0.5 leading-snug">{o.value}</dd>
                      </div>
                    ))}
                  </dl>
                )
                : (
                  <dl class="divide-y divide-warm/60 border-y border-warm/60 text-[0.8125rem]">
                    {d.overview.map((o) => (
                      <div class="grid grid-cols-[6.5rem_1fr] gap-3 py-2">
                        <dt class="eyebrow !text-[0.6875rem] pt-0.5">{o.label}</dt>
                        <dd class="leading-snug">{o.value}</dd>
                      </div>
                    ))}
                  </dl>
                )}
              <h4 class:list={['eyebrow mb-2', d.refined ? 'mt-6 border-t border-warm/60 pt-4' : 'mt-5']}>{d.purposeTitle ?? 'Purpose and experiments'}</h4>
              {d.refined
                ? <p class="text-[0.8125rem] leading-relaxed text-ink-soft">{d.purpose[0]}</p>
                : (
                  <ul class="list-disc space-y-1.5 pl-4 text-[0.8125rem] leading-snug text-ink-soft">
                    {d.purpose.map((x) => <li>{x}</li>)}
                  </ul>
                )}
            </div></aside>

            <div class:list={['p-5 lg:col-span-8', d.refined && 'lg:min-h-[38.5rem]']}>
              {d.sections.length > 1 && (
                <div role="tablist" aria-label={`${d.name} figures`} class="mb-5 flex flex-wrap gap-2">
                  {d.sections.map((sec, si) => (
                    <button type="button" role="tab" data-tab={`${d.id}-${si}`} aria-selected={si === 0} class="border border-ink/30 px-3 py-1.5 text-[0.8125rem] transition-colors hover:border-ink aria-selected:border-ink aria-selected:bg-ink aria-selected:text-paper">
                      {sec.title}
                    </button>
                  ))}
                </div>
              )}
              {d.sections.map((sec, si) => (
                <div role="tabpanel" data-tabpanel={`${d.id}-${si}`} hidden={si !== 0}>
                  {d.sections.length === 1 && <h4 class="eyebrow mb-3 border-b border-ink/25 pb-1.5">{sec.title}</h4>}
                  {sec.note && <p class="mb-4 text-[0.8125rem] leading-snug text-ink-soft">{sec.note}</p>}
                  {d.refined
                    ? (
                      <div class="space-y-7">
                        {(sec.groups ?? [{ title: '', note: undefined, figures: sec.figures }]).map((g) => (
                          <div>
                            {g.title && <h5 class="eyebrow mb-3 border-b border-ink/25 pb-1.5">{g.title}</h5>}
                            {g.figures.length === 1 && g.note
                              ? (
                                <div class="grid items-start gap-x-6 gap-y-3 md:grid-cols-12">
                                  <figure class="md:col-span-5">
                                    <button type="button" data-lightbox={g.figures[0].big} data-alt={g.figures[0].alt} class="group block w-full cursor-zoom-in border border-warm/70 bg-white" aria-label={`Enlarge: ${g.figures[0].alt}`}>
                                      <Image src={g.figures[0].src} alt={g.figures[0].alt} format={g.figures[0].src.src.endsWith('.png') ? 'png' : 'webp'} quality="high" width={1000} class="h-auto w-full p-1.5 transition-opacity group-hover:opacity-90" loading="lazy" />
                                    </button>
                                    <figcaption class="mt-2 text-[0.8125rem] leading-snug text-ink-soft">{g.figures[0].caption}</figcaption>
                                  </figure>
                                  <p class="text-[0.8125rem] leading-relaxed text-ink-soft md:col-span-7">{g.note}</p>
                                </div>
                              )
                              : g.figures.length > 2
                                ? (
                                  <div class="grid gap-x-5 gap-y-6 sm:grid-cols-2">
                                    {g.figures.map((f) => (
                                      <figure>
                                        <button type="button" data-lightbox={f.big} data-alt={f.alt} class="group block w-full cursor-zoom-in border border-warm/70 bg-white" aria-label={`Enlarge: ${f.alt}`}>
                                          <span class="flex aspect-[16/10] items-center justify-center overflow-hidden">
                                            <Image src={f.src} alt={f.alt} format={f.src.src.endsWith('.png') ? 'png' : 'webp'} quality="high" width={760} class:list={['w-full transition-opacity group-hover:opacity-90', f.crop ? 'h-full object-cover' : 'h-full object-contain p-1.5']} loading="lazy" />
                                          </span>
                                        </button>
                                        <figcaption class="mt-2 text-[0.8125rem] leading-snug text-ink-soft">{f.caption}</figcaption>
                                      </figure>
                                    ))}
                                  </div>
                                )
                                : (
                                  <div class="grid gap-x-5 gap-y-6 md:[grid-template-columns:var(--cols)]" style={`--cols:${g.figures.map((f) => (f.src.width / f.src.height).toFixed(2) + 'fr').join(' ')}`}>
                                    {g.figures.map((f) => (
                                      <figure>
                                        <button type="button" data-lightbox={f.big} data-alt={f.alt} class="group block w-full cursor-zoom-in border border-warm/70 bg-white" aria-label={`Enlarge: ${f.alt}`}>
                                          <Image src={f.src} alt={f.alt} format={f.src.src.endsWith('.png') ? 'png' : 'webp'} quality="high" width={1100} class="h-auto w-full p-1.5 transition-opacity group-hover:opacity-90" loading="lazy" />
                                        </button>
                                        <figcaption class="mt-2 max-w-[44rem] text-[0.8125rem] leading-snug text-ink-soft">{f.caption}</figcaption>
                                      </figure>
                                    ))}
                                  </div>
                                )}
                          </div>
                        ))}
                        {sec.sourceNote && <p class="text-[0.8125rem] text-ink-soft">{sec.sourceNote.before}<a href={sec.sourceNote.href} class="link-line" rel="noopener">{sec.sourceNote.linkText}</a>{sec.sourceNote.after}</p>}
                      </div>
                    )
                    : (
                  <div class:list={['grid gap-x-5 gap-y-6', sec.figures.length === 2 && 'sm:grid-cols-2', sec.figures.length >= 3 && 'sm:grid-cols-2 xl:grid-cols-3', sec.figures.length === 1 && 'lg:grid-cols-12 lg:items-start']}>
                    {sec.figures.map((f) => (
                      <figure class:list={[sec.figures.length === 1 && 'contents']}>
                        <button type="button" data-lightbox={f.big} data-alt={f.alt} class:list={['group block w-full cursor-zoom-in border border-warm/70 bg-white', sec.figures.length === 1 && 'lg:col-span-8']} aria-label={`Enlarge: ${f.alt}`}>
                          <span class:list={['flex items-center justify-center overflow-hidden', f.crop && (sec.figures.length === 1 ? 'aspect-[16/10]' : 'aspect-[4/3]')]}>
                            <Image
                              src={f.src}
                              alt={f.alt}
                              format={f.src.src.endsWith('.png') ? 'png' : 'webp'}
                              quality="high"
                              width={900}
                              style={f.position ? `object-position:${f.position}` : undefined}
                              class:list={['w-full transition-opacity group-hover:opacity-85', f.crop ? 'h-full object-cover' : 'h-auto object-contain p-1']}
                              loading="lazy"
                            />
                          </span>
                        </button>
                        <figcaption class:list={['text-[0.8125rem] leading-snug text-ink-soft', sec.figures.length === 1 ? 'lg:col-span-4' : 'mt-2']}>{f.caption}</figcaption>
                      </figure>
                    ))}
                  </div>
                    )}
                </div>
              ))}
              {d.papers && d.refined && (() => { const pubs = d.papers.flatMap((slug) => publications.filter((x) => x.slug === slug)); return pubs.length > 0 && <p class="mt-6 border-t border-warm/60 pt-3 text-[0.8125rem] text-ink-soft">Related publications: {pubs.map((pub, i) => <>{i > 0 && ' · '}<a href={`/research#pub-${pub.slug}`} class="link-line">{pub.venue.split(',')[0]}</a></>)}</p>; })()}
              {d.paper && d.refined && (() => { const pub = publications.find((x) => x.slug === d.paper); return pub && <p class="mt-5 text-[0.8125rem] text-ink-soft">Related publication: <a href={`/research#pub-${pub.slug}`} class="link-line">{pub.venue.split(',')[0]}</a></p>; })()}
              {d.missing && <p class="mt-5 border-l-2 border-clay pl-3 text-xs leading-snug text-ink-soft">[Figure needed] {d.missing}</p>}
            </div>
          </div>
        </section>
      ))}
    </div>
    <dialog id="lightbox" class="m-auto max-h-[92vh] max-w-[min(96vw,72rem)] bg-white p-3 backdrop:bg-ink/60">
      <form method="dialog" class="mb-2 text-right"><button class="text-sm underline underline-offset-4">Close</button></form>
      <img id="lightbox-img" alt="" class="h-auto max-h-[80vh] w-full object-contain" />
    </dialog>
  </Container>
</section>

<!-- Technical work & expertise -->
<section id="methods" class:list={[band, tint]}>
  <Container class={pad}>
    <h2 class={h2}>Technical Experience</h2>
    <ol class="border-t border-ink">
      {story.workflow.map((w, i) => (
        <li id={w.title.startsWith('Model Transfer') ? 'current-research' : undefined} class="scroll-mt-28 grid gap-x-8 gap-y-1.5 border-b border-warm/70 py-4 last:border-b-0 md:grid-cols-12">
          <div class="flex items-baseline gap-3 md:col-span-4">
            <span class="font-display text-sm text-clay">0{i + 1}</span>
            <h3 class="font-display text-lg" style="line-height:1.25">{w.title}</h3>
          </div>
          <p class="max-w-[40rem] text-[0.9rem] leading-relaxed md:col-span-5">{w.text}</p>
          <div class="space-y-2 md:col-span-3">
            {w.core.length > 0 && <p class="text-[0.8125rem] leading-relaxed text-ink-soft">{w.core.join(' · ')}</p>}
            {w.ongoing && <p class="border-l border-dashed border-ink/50 pl-3 text-[0.8125rem] italic leading-relaxed text-ink-soft">{w.ongoing}</p>}
          </div>
        </li>
      ))}
    </ol>

    <div id="model-development" class="mt-10 scroll-mt-28 border-t border-ink/30 pt-5">
      <h3 class={`${h3} mb-1`}>Model Evolution</h3>
      <p class="mb-3 max-w-[44rem] text-sm leading-snug text-ink-soft">A progression of spatiotemporal architectures developed to address missing traffic data, bus-based traffic estimation, and the challenges of citywide modeling.</p>
      <div role="tablist" aria-label="Model architectures" class="mb-4 flex gap-1.5 overflow-x-auto pb-1">
        {story.architectures.map((a) => (
          <button type="button" role="tab" data-arch={a.id} aria-selected={!!a.default} class="shrink-0 whitespace-nowrap border border-ink/30 px-2.5 py-1 text-left text-xs transition-colors hover:border-ink aria-selected:border-ink aria-selected:bg-ink aria-selected:text-paper">
            {a.label}<span class="ml-1.5 opacity-70">· {a.venue}</span>
          </button>
        ))}
      </div>
      {archBig.map((a) => (
        <div role="tabpanel" data-archpanel={a.id} hidden={!a.default} class="grid items-start gap-x-8 gap-y-3 md:grid-cols-[minmax(0,30rem)_1fr]">
          <figure>
            <button type="button" data-lightbox={a.big} data-alt={a.alt} class="group block w-full cursor-zoom-in border border-warm/70 bg-white" aria-label={`Enlarge: ${a.fullName} diagram`}>
              <Image src={a.src} alt={a.alt} format="png" width={700} class="h-52 w-full object-contain p-2 transition-opacity group-hover:opacity-90" loading="lazy" />
            </button>
            <button type="button" data-lightbox={a.big} data-alt={a.alt} class="mt-1 text-xs text-ink-soft underline underline-offset-4 hover:text-clay">Enlarge figure</button>
          </figure>
          <div class="space-y-3 text-[0.875rem] leading-snug">
            <p class="font-display text-base leading-tight">{a.fullName}</p>
            <div><p class="eyebrow mb-0.5">Approach</p><p>{a.approach}</p></div>
            <div><p class="eyebrow mb-0.5">Focus</p><p class="text-ink-soft">{a.focus}</p></div>
            {a.paper && <p class="text-[0.8125rem]"><a href={`/research#pub-${a.paper}`} class="link-line">Read the paper →</a></p>}
          </div>
        </div>
      ))}
    </div>
    {project.links.length > 0 && (
      <p class="mt-6 flex flex-wrap gap-x-6 gap-y-1 text-sm">
        {project.links.map((l) => <a href={l.href} class="link-line">{l.label} →</a>)}
      </p>
    )}
  </Container>
</section>

<!-- Application demo -->
{app && (
  <section id="application" class={band}>
    <Container class={pad}>
      <h2 class={h2}>Application Demo</h2>
      <div class="grid items-start gap-8 lg:grid-cols-12 lg:gap-10">
        <div class="lg:col-span-5">
          <div class="bg-ink p-1">
            {app.video
              ? (
                <video
                  controls
                  preload="metadata"
                  playsinline
                  poster={app.video.poster ? (typeof app.video.poster === 'string' ? app.video.poster : app.video.poster.src) : undefined}
                  class="aspect-video w-full bg-ink"
                  aria-label={app.video.label}
                >
                  <source src={app.video.src} type={app.video.type} />
                  Your browser cannot play this video.
                </video>
              )
              : (shots[0]
                ? <ImagePlaceholder src={shots[0].src} alt={shots[0].alt} label={shots[0].placeholderLabel} tone="teal" ratio="aspect-video" />
                : <ImagePlaceholder src={null} alt="Application demo video (placeholder)" label="Demo video: application walkthrough" tone="teal" ratio="aspect-video" />)}
          </div>
                  </div>
        <div class="lg:col-span-6 lg:col-start-6">
          <p class="eyebrow mb-2">Traffic Analytics Platform</p>
          <p class="text-[0.9375rem] leading-relaxed">An interactive Streamlit application for estimating and comparing urban traffic speeds using real-time bus observations.</p>
          <ul class="mt-4 divide-y divide-warm/70 border-y border-warm/70">
            {app.features.map((f) => (
              <li class="py-2.5"><p class="font-display text-base">{f.title}</p><p class="mt-0.5 text-[0.8125rem] leading-snug text-ink-soft">{f.text}</p></li>
            ))}
          </ul>
          {(app.video ? shots : shots.slice(1)).map((sh) => (
            <ImagePlaceholder src={sh.src} alt={sh.alt} label={sh.placeholderLabel} tone="sage" ratio="aspect-[16/7]" class="mt-4" />
          ))}
          {app.demoUrl && (
            <p class="mt-5"><a href={app.demoUrl} class="inline-block border border-teal bg-teal px-5 py-2.5 text-sm text-paper transition-colors hover:border-teal-deep hover:bg-teal-deep">Open live demo →</a></p>
          )}
        </div>
      </div>
    </Container>
  </section>
)}

<!-- Publications -->
<section id="publications" class:list={[band, tint]}>
  <Container class={pad}>
    <h2 class={h2}>Publications</h2>
    <ul class="divide-y divide-warm/70 border-y border-warm/70">
      {refs.map((p) => (
        <li>
          <a href={`/research#pub-${p.slug}`} class="group grid items-baseline gap-x-5 gap-y-0.5 py-3 transition-colors hover:text-teal sm:grid-cols-[3rem_9.5rem_1fr]">
            <span class="font-display text-clay">{p.year}</span>
            <span class="eyebrow">{p.venue.split(',')[0]}</span>
            <span class="font-display text-[0.95rem] leading-snug lg:whitespace-nowrap">{p.title}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="mt-4 text-sm"><a href="/research#publications" class="link-line">Explore all publications →</a></p>
  </Container>
</section>

<!-- Funding -->
<section id="funding" class={band}>
  <Container class="py-6 sm:py-9">
    <div class="grid items-start gap-x-10 gap-y-3 lg:grid-cols-12">
      <h2 class="font-display-tight text-3xl font-light sm:text-[2.1rem] lg:col-span-2">Funding</h2>
      <p class="max-w-[48rem] text-base leading-[1.65] lg:col-span-7">This research is supported by the EMERALDS project, funded by the European Union's Horizon Europe programme.</p>
      <p class="text-sm lg:col-span-3 lg:pt-1.5 lg:text-right lg:whitespace-nowrap"><a href={emeralds.href} class="link-line">Explore my work in EMERALDS →</a></p>
    </div>
  </Container>
</section>

<script>
  const gallery = document.getElementById('dataset-gallery');
  if (gallery) {
    const openers = [...gallery.querySelectorAll<HTMLButtonElement>('[data-open]')];
    const panels = [...document.querySelectorAll<HTMLElement>('[data-panel]')];
    const show = (id: string | null, scroll = true) => {
      panels.forEach((p) => { p.hidden = p.dataset.panel !== id; });
      openers.forEach((b) => {
        const on = b.dataset.open === id;
        b.setAttribute('aria-expanded', String(on));
        (b.querySelector('[data-label]') as HTMLElement).textContent = on ? 'Hide details' : 'Show more';
        b.closest('article')?.classList.toggle('border-ink', on);
        b.closest('article')?.classList.toggle('border-transparent', !on);
      });
      if (id && scroll) document.getElementById(`panel-${id}`)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };
    openers.forEach((b) => b.addEventListener('click', () => show(b.getAttribute('aria-expanded') === 'true' ? null : b.dataset.open!)));
    panels.forEach((p) => p.querySelector('[data-close]')?.addEventListener('click', () => {
      const id = p.dataset.panel!;
      show(null);
      openers.find((b) => b.dataset.open === id)?.focus();
    }));
  }

  document.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach((tab) => {
    tab.addEventListener('click', () => {
      const id = tab.dataset.tab!;
      const panel = tab.closest('[data-panel]')!;
      panel.querySelectorAll<HTMLElement>('[data-tab]').forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
      panel.querySelectorAll<HTMLElement>('[data-tabpanel]').forEach((p) => { p.hidden = p.dataset.tabpanel !== id; });
    });
  });

  document.querySelectorAll<HTMLButtonElement>('[data-arch]').forEach((tab) => {
    tab.addEventListener('click', () => {
      const root = tab.closest('#model-development')!;
      root.querySelectorAll<HTMLElement>('[data-arch]').forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
      root.querySelectorAll<HTMLElement>('[data-archpanel]').forEach((p) => { p.hidden = p.dataset.archpanel !== tab.dataset.arch; });
    });
  });

  const lb = document.getElementById('lightbox') as HTMLDialogElement | null;
  const lbImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
  if (lb && lbImg) {
    document.querySelectorAll<HTMLButtonElement>('[data-lightbox]').forEach((b) =>
      b.addEventListener('click', () => { lbImg.src = b.dataset.lightbox!; lbImg.alt = b.dataset.alt ?? ''; lb.showModal(); }),
    );
    lb.addEventListener('click', (e) => { if (e.target === lb) lb.close(); });
  }

  document.querySelectorAll<HTMLButtonElement>('[data-zoom]').forEach((btn) => {
    const dlg = document.getElementById(btn.dataset.zoom!) as HTMLDialogElement | null;
    if (!dlg) return;
    btn.addEventListener('click', () => dlg.showModal());
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  });
</script>
