---
import type { Project, ProjectStory } from '~/data/projects';
import { publications } from '~/data/publications';
import { emeralds } from '~/data/emeralds';
import Container from './Container.astro';
import Figure from './Figure.astro';
import ImagePlaceholder from './ImagePlaceholder.astro';

/** Long-form layout for a project with a `story` (see ProjectStory in data/projects.ts). */
interface Props { project: Project; story: ProjectStory }
const { project, story } = Astro.props;
const app = project.application;
const shots = (app?.screenshots ?? []).filter((x) => x.src);

const refs = publications
  .filter((p) => project.publications.includes(p.slug))
  .sort((a, b) => b.year - a.year);
const pubLabel = (slug: string) => publications.find((p) => p.slug === slug);

const row = 'scroll-mt-28 border-t border-warm/70 py-8 sm:py-10';
const label = 'eyebrow mb-4';
---
<Container class="pt-2">
  <!-- Overview -->
  <section id="overview" class={row}>
    <div class="grid gap-6 lg:grid-cols-12 lg:gap-10">
      <h2 class={`${label} lg:col-span-3`}>Overview</h2>
      <div class="max-w-2xl space-y-4 lg:col-span-8">
        {story.overview.map((p) => <p class="text-lg">{p}</p>)}
      </div>
    </div>
    <dl class="mt-8 grid grid-cols-2 gap-x-6 gap-y-6 border-y border-warm/70 py-6 lg:grid-cols-4">
      {story.facts.map((f) => (
        <div>
          <dt class="font-display-tight text-3xl font-light text-teal sm:text-4xl">{f.value}</dt>
          <dd class="mt-1 text-sm text-ink-soft">{f.label}</dd>
        </div>
      ))}
    </dl>
    <div class="mt-6 max-w-2xl">
      <details class="group/d border-t border-warm/70 py-3 [&>summary]:flex [&>summary]:cursor-pointer [&>summary]:list-none [&>summary]:items-center [&>summary]:justify-between [&>summary::-webkit-details-marker]:hidden">
        <summary class="text-sm"><span class="eyebrow">Research contributions</span><span aria-hidden="true" class="text-ink-soft transition-transform group-open/d:rotate-45">+</span></summary>
        <ul class="mt-3 list-disc space-y-2 pl-5 text-ink-soft">{project.contributions.map((c) => <li>{c}</li>)}</ul>
      </details>
      <details class="group/d border-y border-warm/70 py-3 [&>summary]:flex [&>summary]:cursor-pointer [&>summary]:list-none [&>summary]:items-center [&>summary]:justify-between [&>summary::-webkit-details-marker]:hidden">
        <summary class="text-sm"><span class="eyebrow">Technologies</span><span aria-hidden="true" class="text-ink-soft transition-transform group-open/d:rotate-45">+</span></summary>
        <p class="mt-3 text-ink-soft">{project.technologies.join(' · ')}</p>
      </details>
    </div>
  </section>

  <!-- Research journey -->
  <section id="journey" class={row}>
    <h2 class={label}>Research journey</h2>
    <p class="mb-8 max-w-xl text-ink-soft">Connected stages of one doctoral research project, up to the work in progress.</p>
    <ol class="grid gap-8 lg:grid-cols-5 lg:gap-0">
      {story.journey.map((s, i) => (
        <li class:list={['relative border-l pl-6 lg:border-l-0 lg:border-t lg:pl-0 lg:pr-5 lg:pt-6', s.status === 'ongoing' ? 'border-dashed border-clay' : 'border-ink']}>
          <span aria-hidden="true" class:list={['absolute -left-[5px] top-1.5 size-[9px] rounded-full lg:left-0 lg:-top-[5px]', s.status === 'ongoing' ? 'border border-clay bg-paper' : 'bg-clay']}></span>
          <p class="font-display text-sm text-clay">0{i + 1}{s.status === 'ongoing' && ' · In progress'}</p>
          <h3 class="font-display mt-1 text-xl" style="line-height:1.2">{s.title}</h3>
          <p class="mt-2 text-sm text-ink-soft">{s.text}</p>
          <p class="mt-3 text-sm">{s.scale}</p>
          <p class="mt-3 flex flex-wrap gap-x-3 gap-y-1 text-sm">
            {s.publications.map((slug) => {
              const p = pubLabel(slug);
              return p && <a href={`/research#pub-${slug}`} class="link-line">{p.venue.split(',')[0]}</a>;
            })}
            {s.title === 'Interactive analytics' && app && <a href="#application" class="link-line">See the application ↓</a>}
            {s.status === 'ongoing' && <a href="#current-research" class="link-line">Current research ↓</a>}
          </p>
        </li>
      ))}
    </ol>

    <div id="current-research" class="mt-10 scroll-mt-28 border-t border-dashed border-clay/70 pt-6">
      <h3 class="eyebrow mb-5">Current research · active and exploratory, not yet published</h3>
      <div class="grid gap-8 md:grid-cols-2 md:gap-10">
        {story.currentResearch.map((c) => (
          <div>
            <p class="flex flex-wrap items-baseline gap-x-3">
              <span class="font-display text-xl">{c.title}</span>
              <span class="border border-clay/60 px-2 py-0.5 text-xs text-clay">{c.status}</span>
            </p>
            <ul class="mt-3 list-disc space-y-2 pl-5 text-ink-soft">{c.points.map((pt) => <li>{pt}</li>)}</ul>
            {c.example && (
              <details class="group/d mt-4 border-t border-warm/70 py-3 [&>summary]:flex [&>summary]:cursor-pointer [&>summary]:list-none [&>summary]:items-center [&>summary]:justify-between [&>summary::-webkit-details-marker]:hidden">
                <summary class="text-sm"><span class="eyebrow">Show an example</span><span aria-hidden="true" class="text-ink-soft transition-transform group-open/d:rotate-45">+</span></summary>
                <Figure figure={c.example} format="png" class="mt-4 max-w-md" />
              </details>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Data & methodology -->
  <section id="methodology" class={row}>
    <h2 class={label}>Data &amp; methodology</h2>
    <p class="mb-8 max-w-2xl text-lg">{story.methodology}</p>
    <div class="grid gap-x-8 gap-y-7 md:grid-cols-2 lg:grid-cols-3">
      {story.dataAreas.map((g) => (
        <div class="border-t border-ink pt-3">
          <h3 class="font-display text-lg" style="line-height:1.25">{g.title}</h3>
          <ul class="mt-2 space-y-2 text-sm text-ink-soft">
            {g.points.map((pt) => <li>{pt}</li>)}
          </ul>
          {g.tools && <p class="mt-3 text-sm">{g.tools}</p>}
        </div>
      ))}
    </div>
    <p class="mt-6 max-w-2xl border-l-2 border-clay pl-4 text-sm text-ink-soft">{story.dataNote}</p>
    <div class="mt-10 grid items-start gap-8 md:grid-cols-2">
      <Figure figure={story.networkFigure} />
      <Figure figure={story.architectureFigure} format="png" />
    </div>
    {project.links.length > 0 && (
      <p class="mt-6 flex flex-wrap gap-x-6 gap-y-1 text-sm">
        {project.links.map((l) => <a href={l.href} class="link-line">{l.label} →</a>)}
      </p>
    )}
  </section>

  <!-- Results -->
  <section id="results" class={row}>
    <h2 class={label}>Selected results</h2>
    <ol class="divide-y divide-warm/70 border-y border-warm/70">
      {story.findings.map((f) => (
        <li class="grid gap-2 py-5 md:grid-cols-12 md:gap-8">
          <p class="font-display-tight text-2xl font-light text-teal sm:text-3xl md:col-span-3">{f.value}</p>
          <p class="md:col-span-5">{f.claim}</p>
          <p class="text-sm text-ink-soft md:col-span-4">{f.scope}</p>
        </li>
      ))}
    </ol>
    <p class="mt-3 text-sm text-ink-soft">These findings come from different experiments and are not directly comparable.</p>

    <div class="mt-10 grid items-start gap-8 md:grid-cols-2">
      {story.errorFigures.map((f) => <Figure figure={f} format={f.src?.src.endsWith('.png') ? 'png' : 'webp'} />)}
    </div>

    <div class="mt-10 grid gap-8 md:grid-cols-2">
      <div>
        <h3 class="eyebrow mb-3">Limitations</h3>
        <ul class="list-disc space-y-2 pl-5 text-ink-soft">{story.limitations.map((l) => <li>{l}</li>)}</ul>
      </div>
      <div>
        <h3 class="eyebrow mb-3">Open questions · not yet results</h3>
        <ul class="list-disc space-y-2 pl-5 text-ink-soft">{story.nextSteps.map((l) => <li>{l}</li>)}</ul>
      </div>
    </div>
  </section>

  <!-- Interactive application -->
  {app && (
    <section id="application" class="scroll-mt-28 border-t border-warm/70 py-8 sm:py-10">
      <div class="bg-paper-deep p-5 sm:p-8">
        <div class="grid gap-8 lg:grid-cols-12 lg:gap-10">
          <div class="lg:col-span-4">
            <p class="eyebrow mb-3">Interactive application</p>
            <h2 class="font-display-tight text-2xl font-light sm:text-3xl" style="line-height:1.1">{app.title}</h2>
            <p class="mt-3 text-ink-soft">{app.summary}</p>
            <ul class="mt-5 divide-y divide-warm/70 border-y border-warm/70">
              {app.features.map((f) => (
                <li class="py-3"><p class="font-display text-lg">{f.title}</p><p class="text-sm text-ink-soft">{f.text}</p></li>
              ))}
            </ul>
            {app.demoUrl && (
              <p class="mt-6"><a href={app.demoUrl} class="inline-block border border-teal bg-teal px-6 py-3 text-[0.9375rem] text-paper transition-colors hover:border-teal-deep hover:bg-teal-deep">Open live demo →</a></p>
            )}
          </div>
          <div class="lg:col-span-8">
            {app.video
              ? (
                <figure>
                  <video
                    controls
                    preload="metadata"
                    playsinline
                    poster={app.video.poster ? (typeof app.video.poster === 'string' ? app.video.poster : app.video.poster.src) : undefined}
                    class="aspect-video w-full bg-ink"
                    aria-label={app.video.label}
                  >
                    <source src={app.video.src} type={app.video.type} />
                    Your browser cannot play this video.
                  </video>
                  <figcaption class="mt-2 text-sm text-ink-soft">{app.video.label}</figcaption>
                </figure>
              )
              : (shots[0]
                ? <ImagePlaceholder src={shots[0].src} alt={shots[0].alt} label={shots[0].placeholderLabel} tone="teal" ratio="aspect-[16/10]" />
                : <ImagePlaceholder src={null} alt="Application demo video (placeholder)" label="Demo video: application walkthrough" tone="teal" ratio="aspect-video" />)}
            {(app.video ? shots : shots.slice(1)).map((sh) => (
              <ImagePlaceholder src={sh.src} alt={sh.alt} label={sh.placeholderLabel} tone="sage" ratio="aspect-[16/7]" class="mt-4 md:w-2/3" />
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Publications & EMERALDS -->
  <section id="publications" class={`${row} border-b`}>
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <h2 class={label}>Related publications</h2>
        <ul class="divide-y divide-warm/70 border-y border-warm/70">
          {refs.map((p) => (
            <li>
              <a href={`/research#pub-${p.slug}`} class="group grid gap-1 py-4 transition-colors hover:text-teal sm:grid-cols-[4.5rem_1fr] sm:gap-4">
                <span class="font-display text-clay">{p.year}</span>
                <span>
                  <span class="eyebrow block">{p.venue.split(',')[0]}</span>
                  <span class="font-display mt-1 block text-lg" style="line-height:1.25">{p.title}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
        <p class="mt-4 text-sm"><a href="/research#publications" class="link-line">All publications on the Research page →</a></p>
      </div>
      <div id="emeralds-link" class="lg:col-span-4 lg:col-start-9">
        <h2 class={label}>EMERALDS</h2>
        <p>This doctoral research also contributed to the EU Horizon Europe EMERALDS project. {emeralds.relation}</p>
        <p class="mt-4 text-sm"><a href={emeralds.href} class="link-line">EMERALDS on the Experience page →</a></p>
      </div>
    </div>
  </section>
</Container>
