---
import type { Project, ProjectStory } from '~/data/projects';
import { publications } from '~/data/publications';
import { emeralds } from '~/data/emeralds';
import Container from './Container.astro';
import Figure from './Figure.astro';
import Placeholder from './Placeholder.astro';
import ImagePlaceholder from './ImagePlaceholder.astro';

/** Long-form layout for a project with a `story` (see ProjectStory in data/projects.ts). */
interface Props { project: Project; story: ProjectStory }
const { project, story } = Astro.props;
const app = project.application;
const shots = (app?.screenshots ?? []).filter((x) => x.src);

const refs = publications
  .filter((p) => project.publications.includes(p.slug))
  .sort((a, b) => b.year - a.year);

const band = 'scroll-mt-28 border-t border-warm/70';
const tint = 'bg-paper-deep/60';
const pad = 'py-8 sm:py-12';
const h2 = 'font-display-tight mb-5 text-3xl font-light sm:mb-6 sm:text-4xl';
const h3 = 'font-display text-xl';
const sub = 'mt-8 border-t border-warm/70 pt-5';
const toggle = 'group/d border-t border-warm/70 py-3 [&>summary]:flex [&>summary]:cursor-pointer [&>summary]:list-none [&>summary]:items-center [&>summary]:justify-between [&>summary::-webkit-details-marker]:hidden';
---
<!-- Overview -->
<section id="overview" class={band}>
  <Container class={pad}>
    <h2 class={h2}>Overview</h2>
    <div class="grid items-start gap-8 lg:grid-cols-12 lg:gap-12">
      <div class="max-w-2xl space-y-4 text-lg lg:col-span-7 text-justify hyphens-auto">
        {story.overview.map((p) => <p>{p}</p>)}
      </div>
      {story.overviewMedia && (
        <figure class="lg:col-span-5">
          <picture>
            <source media="(prefers-reduced-motion: reduce)" srcset={story.overviewMedia.still} />
            <img
              src={story.overviewMedia.src}
              alt={story.overviewMedia.alt}
              width={story.overviewMedia.width}
              height={story.overviewMedia.height}
              loading="lazy"
              decoding="async"
              class="h-auto w-full border border-warm/60"
            />
          </picture>
          <figcaption class="mt-2 text-sm text-ink-soft">{story.overviewMedia.caption}</figcaption>
        </figure>
      )}
    </div>
    <dl class="mt-8 grid gap-6 border-y border-warm/70 py-6 sm:grid-cols-3 sm:gap-8">
      {story.facts.map((f) => (
        <div>
          <dt class="font-display-tight text-3xl font-light text-teal sm:text-4xl">{f.value}</dt>
          <dd class="mt-1 text-sm text-ink-soft">{f.label}</dd>
        </div>
      ))}
    </dl>
  </Container>
</section>

<!-- Research journey -->
<section id="journey" class:list={[band, tint]}>
  <Container class={pad}>
    <h2 class={h2}>Research Journey</h2>
    <ol class="grid gap-9 lg:grid-cols-5 lg:gap-x-0">
      {story.journey.map((s, i) => {
        const ongoing = s.status === 'ongoing';
        return (
          <li class:list={['relative border-l pl-6 lg:border-l-0 lg:border-t lg:pl-0 lg:pr-6 lg:pt-6', ongoing ? 'border-dashed border-ink/50' : 'border-ink']}>
            <span aria-hidden="true" class:list={['absolute -left-[5px] top-1.5 size-[9px] rounded-full lg:left-0 lg:-top-[5px]', ongoing ? 'border border-ink/60 bg-paper' : 'bg-clay']}></span>
            <p class="font-display text-sm text-clay">
              0{i + 1}
              {ongoing && <span class="ml-2 font-sans text-xs italic text-ink-soft">In progress</span>}
            </p>
            <h3 class="font-display mt-1 text-2xl lg:text-xl" style="line-height:1.15">{s.title}</h3>
            <p class="mt-3 max-w-xl text-[0.95rem] text-ink-soft lg:text-sm">
              <span class="lg:hidden">{s.text}</span><span class="hidden lg:inline">{s.short}</span>
            </p>
            {s.topics && <p class="mt-3 text-sm">{s.topics.join(' · ')}</p>}
            {(s.details.length > 0 || s.papers.length > 0 || s.features) && (
              <div class="mt-4 space-y-1.5 border-t border-warm/60 pt-3 text-sm text-ink-soft lg:text-[0.8125rem]">
                {s.details.map((d) => <p><span class="eyebrow mr-2">{d.label}</span>{d.text}</p>)}
                {s.features && <p><span class="eyebrow mr-2">Features</span>{s.features}{app && <> · <a href="#application" class="link-line">See the application ↓</a></>}</p>}
                {s.papers.length > 0 && (
                  <p>
                    <span class="eyebrow mr-2">{s.papers.length > 1 ? 'Publications' : 'Publication'}</span>
                    {s.papers.map((pp, k) => <>{k > 0 && ' · '}<a href={`/research#pub-${pp.slug}`} class="link-line">{pp.label}</a></>)}
                  </p>
                )}
              </div>
            )}
            {ongoing && <p class="mt-3 text-sm"><a href="#current-research" class="link-line">Current research ↓</a></p>}
          </li>
        );
      })}
    </ol>

    <div id="current-research" class="mt-10 scroll-mt-28 border-t border-dashed border-clay/70 pt-6">
      <h3 class={h3}>Current research</h3>
      <p class="mb-5 mt-1 text-sm text-ink-soft">Active and exploratory, not yet published.</p>
      <div class="grid gap-8 md:grid-cols-2 md:gap-10">
        {story.currentResearch.map((c) => (
          <div>
            <p class="flex flex-wrap items-baseline gap-x-3">
              <span class="font-display text-lg">{c.title}</span>
              <span class="border border-clay/60 px-2 py-0.5 text-xs text-clay">{c.status}</span>
            </p>
            <ul class="mt-3 list-disc space-y-2 pl-5 text-ink-soft">{c.points.map((pt) => <li>{pt}</li>)}</ul>
            {c.example && (
              <details class={`${toggle} mt-4`}>
                <summary class="text-sm"><span class="eyebrow">Show an example</span><span aria-hidden="true" class="text-ink-soft transition-transform group-open/d:rotate-45">+</span></summary>
                <Figure figure={c.example} format="png" class="mt-4 max-w-md" />
              </details>
            )}
          </div>
        ))}
      </div>
    </div>
  </Container>
</section>

<!-- Data & methodology -->
<section id="methodology" class={band}>
  <Container class={pad}>
    <h2 class={h2}>Data &amp; methodology</h2>
    <p class="mb-8 max-w-2xl text-lg text-justify hyphens-auto">{story.methodology}</p>
    <div class="grid gap-x-8 gap-y-7 md:grid-cols-2 lg:grid-cols-3">
      {story.dataAreas.map((g) => (
        <div class="border-t border-ink pt-3">
          <h3 class="font-display text-lg" style="line-height:1.25">{g.title}</h3>
          <ul class="mt-2 space-y-2 text-sm text-ink-soft text-justify hyphens-auto">
            {g.points.map((pt) => <li>{pt}</li>)}
          </ul>
          {g.tools && <p class="mt-3 text-sm">{g.tools}</p>}
        </div>
      ))}
    </div>
    <p class="mt-6 max-w-2xl border-l-2 border-clay pl-4 text-sm text-ink-soft text-justify hyphens-auto">{story.dataNote}</p>

    <div class={sub}>
      <h3 class={`${h3} mb-5`}>Study network and model</h3>
      <div class="grid items-start gap-8 md:grid-cols-2">
        <Figure figure={story.networkFigure} />
        <Figure figure={story.architectureFigure} format="png" />
      </div>
      {project.links.length > 0 && (
        <p class="mt-6 flex flex-wrap gap-x-6 gap-y-1 text-sm">
          {project.links.map((l) => <a href={l.href} class="link-line">{l.label} →</a>)}
        </p>
      )}
    </div>
  </Container>
</section>

<!-- Technologies -->
<section id="technologies" class:list={[band, tint]}>
  <Container class={pad}>
    <h2 class={h2}>Technologies &amp; tools</h2>
    <div class="hidden border-b border-ink pb-2 md:grid md:grid-cols-12 md:gap-6">
      <span class="md:col-span-3"></span>
      <p class="eyebrow md:col-span-4">Core · used extensively in the research</p>
      <p class="eyebrow md:col-span-5">Also worked with or explored</p>
    </div>
    <dl class="divide-y divide-warm/70 border-b border-warm/70 md:border-b-0">
      {story.toolkit.map((t) => (
        <div class="grid gap-x-6 gap-y-1 py-3 md:grid-cols-12">
          <dt class="font-display text-lg md:col-span-3" style="line-height:1.25">{t.category}</dt>
          <dd class="text-sm md:col-span-4">
            <span class="eyebrow mr-2 md:hidden">Core</span>{t.core.join(' · ')}
          </dd>
          <dd class="text-sm text-ink-soft md:col-span-5">
            <span class="eyebrow mr-2 md:hidden">Also</span>
            {t.additional.length ? t.additional.join(' · ') : t.todo ? <Placeholder>{t.todo}</Placeholder> : '—'}
          </dd>
        </div>
      ))}
    </dl>
  </Container>
</section>

<!-- Results -->
<section id="results" class={band}>
  <Container class={pad}>
    <h2 class={h2}>Selected results</h2>
    <ol class="divide-y divide-warm/70 border-y border-warm/70">
      {story.findings.map((f) => (
        <li class="grid gap-2 py-5 md:grid-cols-12 md:gap-8">
          <p class="font-display-tight text-2xl font-light text-teal sm:text-3xl md:col-span-3">{f.value}</p>
          <p class="md:col-span-5 text-justify hyphens-auto">{f.claim}</p>
          <p class="text-sm text-ink-soft md:col-span-4 text-justify hyphens-auto">{f.scope}</p>
        </li>
      ))}
    </ol>
    <p class="mt-3 text-sm text-ink-soft">These findings come from different experiments and are not directly comparable.</p>

    <div class={sub}>
      <h3 class={`${h3} mb-5`}>Citywide error analysis</h3>
      <div class="grid items-start gap-8 md:grid-cols-2">
        {story.errorFigures.map((f) => <Figure figure={f} format={f.src?.src.endsWith('.png') ? 'png' : 'webp'} />)}
      </div>
    </div>

    <div class={`${sub} grid gap-8 md:grid-cols-2`}>
      <div>
        <h3 class={`${h3} mb-3`}>Limitations</h3>
        <ul class="list-disc space-y-2 pl-5 text-ink-soft text-justify hyphens-auto">{story.limitations.map((l) => <li>{l}</li>)}</ul>
      </div>
      <div>
        <h3 class={h3}>Open questions</h3>
        <p class="mb-3 mt-1 text-sm text-ink-soft">Not yet results.</p>
        <ul class="list-disc space-y-2 pl-5 text-ink-soft text-justify hyphens-auto">{story.nextSteps.map((l) => <li>{l}</li>)}</ul>
      </div>
    </div>
  </Container>
</section>

<!-- Interactive application -->
{app && (
  <section id="application" class:list={[band, tint]}>
    <Container class={pad}>
      <h2 class={h2}>Interactive application</h2>
      <div class="bg-paper p-5 sm:p-8">
        <div class="grid gap-8 lg:grid-cols-12 lg:gap-10">
          <div class="lg:col-span-4">
            <h3 class={`${h3} sm:text-2xl`} style="line-height:1.15">{app.title}</h3>
            <p class="mt-3 text-ink-soft text-justify hyphens-auto">{app.summary}</p>
            <ul class="mt-5 divide-y divide-warm/70 border-y border-warm/70">
              {app.features.map((f) => (
                <li class="py-3"><p class="font-display text-lg">{f.title}</p><p class="text-sm text-ink-soft">{f.text}</p></li>
              ))}
            </ul>
            {app.demoUrl && (
              <p class="mt-6"><a href={app.demoUrl} class="inline-block border border-teal bg-teal px-6 py-3 text-[0.9375rem] text-paper transition-colors hover:border-teal-deep hover:bg-teal-deep">Open live demo →</a></p>
            )}
          </div>
          <div class="lg:col-span-8">
            {app.video
              ? (
                <figure>
                  <video
                    controls
                    preload="metadata"
                    playsinline
                    poster={app.video.poster ? (typeof app.video.poster === 'string' ? app.video.poster : app.video.poster.src) : undefined}
                    class="aspect-video w-full bg-ink"
                    aria-label={app.video.label}
                  >
                    <source src={app.video.src} type={app.video.type} />
                    Your browser cannot play this video.
                  </video>
                  <figcaption class="mt-2 text-sm text-ink-soft">{app.video.label}</figcaption>
                </figure>
              )
              : (shots[0]
                ? <ImagePlaceholder src={shots[0].src} alt={shots[0].alt} label={shots[0].placeholderLabel} tone="teal" ratio="aspect-[16/10]" />
                : <ImagePlaceholder src={null} alt="Application demo video (placeholder)" label="Demo video: application walkthrough" tone="teal" ratio="aspect-video" />)}
            {(app.video ? shots : shots.slice(1)).map((sh) => (
              <ImagePlaceholder src={sh.src} alt={sh.alt} label={sh.placeholderLabel} tone="sage" ratio="aspect-[16/7]" class="mt-4 md:w-2/3" />
            ))}
          </div>
        </div>
      </div>
    </Container>
  </section>
)}

<!-- Publications & EMERALDS -->
<section id="publications" class={band}>
  <Container class={pad}>
    <h2 class={h2}>Publications &amp; EMERALDS</h2>
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <h3 class={`${h3} mb-3`}>Related publications</h3>
        <ul class="divide-y divide-warm/70 border-y border-warm/70">
          {refs.map((p) => (
            <li>
              <a href={`/research#pub-${p.slug}`} class="group grid gap-1 py-4 transition-colors hover:text-teal sm:grid-cols-[4.5rem_1fr] sm:gap-4">
                <span class="font-display text-clay">{p.year}</span>
                <span>
                  <span class="eyebrow block">{p.venue.split(',')[0]}</span>
                  <span class="font-display mt-1 block text-lg" style="line-height:1.25">{p.title}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
        <p class="mt-4 text-sm"><a href="/research#publications" class="link-line">All publications on the Research page →</a></p>
      </div>
      <div id="emeralds-link" class="lg:col-span-4 lg:col-start-9">
        <h3 class={`${h3} mb-3`}>EMERALDS</h3>
        <p class="text-justify hyphens-auto">This doctoral research also contributed to the EU Horizon Europe EMERALDS project. {emeralds.relation}</p>
        <p class="mt-4 text-sm"><a href={emeralds.href} class="link-line">EMERALDS on the Experience page →</a></p>
      </div>
    </div>
  </Container>
</section>
