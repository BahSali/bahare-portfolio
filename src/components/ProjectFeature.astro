---
import type { Project } from '~/data/projects';
import { categoryLabels } from '~/data/projects';
import ImagePlaceholder from './ImagePlaceholder.astro';

interface Props { project: Project; index: number; reversed?: boolean }
const { project, index, reversed = false } = Astro.props;
const num = String(index + 1).padStart(2, '0');
const tones = ['sage', 'warm', 'teal'] as const;
const href = `/projects/${project.slug}`;
---
<article class="group grid items-end gap-8 lg:grid-cols-12 lg:gap-10">
  <a href={href} tabindex="-1" aria-hidden="true" class:list={['block overflow-hidden lg:col-span-7', reversed ? 'lg:order-2 lg:col-start-6' : 'lg:order-1']}>
    <div class="transition-transform duration-700 ease-out group-hover:scale-[1.015]">
      <ImagePlaceholder
        src={project.image.src}
        alt={project.image.alt}
        label={project.image.placeholderLabel}
        tone={tones[index % tones.length]}
        ratio="aspect-[4/3] lg:aspect-[16/11]"
      />
    </div>
  </a>
  <div class:list={['lg:col-span-4', reversed ? 'lg:order-1 lg:col-start-1' : 'lg:order-2 lg:col-start-9 lg:pb-6']}>
    <p class="font-display text-5xl font-light text-clay" aria-hidden="true">{num}</p>
    <p class="eyebrow mt-4">{categoryLabels[project.category]}</p>
    <h3 class="font-display-tight mt-3 text-2xl font-normal sm:text-3xl" style="line-height:1.12">
      <a href={href} class="transition-colors hover:text-teal">{project.title}</a>
    </h3>
    <p class="mt-4 text-ink-soft">{project.summary}</p>
    <p class="mt-5 text-sm"><a href={href} class="link-line">View project →</a></p>
  </div>
</article>
