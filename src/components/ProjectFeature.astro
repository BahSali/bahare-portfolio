---
import type { Project } from '~/data/projects';
import ImagePlaceholder from './ImagePlaceholder.astro';
import Placeholder from './Placeholder.astro';

interface Props { project: Project; index: number; reversed?: boolean }
const { project, index, reversed = false } = Astro.props;
const num = String(index + 1).padStart(2, '0');
const tones = ['sage', 'warm', 'teal'] as const;
---
<article class="group grid items-end gap-8 lg:grid-cols-12 lg:gap-10">
  <div class:list={['overflow-hidden lg:col-span-7', reversed ? 'lg:order-2 lg:col-start-6' : 'lg:order-1']}>
    <div class="transition-transform duration-700 ease-out group-hover:scale-[1.015]">
      <ImagePlaceholder
        src={project.image.src}
        alt={project.image.alt}
        label={project.image.placeholderLabel}
        tone={tones[index % tones.length]}
        ratio="aspect-[4/3] lg:aspect-[16/11]"
      />
    </div>
  </div>
  <div class:list={['lg:col-span-4', reversed ? 'lg:order-1 lg:col-start-1' : 'lg:order-2 lg:col-start-9 lg:pb-6']}>
    <p class="font-display text-5xl font-light text-clay" aria-hidden="true">{num}</p>
    <h3 class="font-display-tight mt-4 text-2xl font-normal sm:text-3xl" style="line-height:1.12">{project.title}</h3>
    <p class="mt-4 text-ink-soft">{project.summary}</p>
    <ul class="mt-5 flex flex-wrap gap-x-4 gap-y-1 text-sm text-ink">
      {project.themes.map((t) => <li class="after:ml-4 after:text-warm after:content-['/'] last:after:content-none">{t}</li>)}
    </ul>
    <p class="mt-5 text-sm">
      {project.link
        ? <a href={project.link.href} class="link-line">{project.link.label}</a>
        : <Placeholder>Year, role and project link to be added</Placeholder>}
    </p>
  </div>
</article>
