---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Container from './Container.astro';
import SectionHeading from './SectionHeading.astro';

interface Props { title: string; eyebrow: string; description: string; planned: string[] }
const { title, eyebrow, description, planned } = Astro.props;
---
<BaseLayout title={title} description={description}>
  <Container class="py-section-sm">
    <SectionHeading as="h1" eyebrow={eyebrow} title={title}>
      <p class="mt-6 text-lg text-ink-soft">{description}</p>
    </SectionHeading>

    <div class="mt-14 max-w-xl border-t border-warm/70 pt-6">
      <p class="eyebrow mb-4">Page under construction</p>
      <p class="text-ink-soft">This page will be built out next. Planned content:</p>
      <ul class="mt-4 space-y-2">
        {planned.map((p) => <li class="flex gap-3"><span class="text-clay" aria-hidden="true">—</span>{p}</li>)}
      </ul>
      <slot />
      <p class="mt-10"><a href="/" class="link-line">← Back to Home</a></p>
    </div>
  </Container>
</BaseLayout>
