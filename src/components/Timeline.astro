---
import type { TimelineItem } from '~/lib/timeline';
import { isDated, lanes } from '~/lib/timeline';
import TimelineEntry from './TimelineEntry.astro';

/**
 * Career timeline. With a start year on every entry it draws periods to scale on a year axis, so
 * overlapping study and work sit side by side in their lanes. Until then it shows entries in `order`,
 * one per row, still separated into lanes.
 */
interface Props { items: TimelineItem[] }
const { items } = Astro.props;

const currentYear = new Date().getFullYear();
const endYear = (i: TimelineItem) => (i.end === 'present' ? currentYear : (i.end ?? i.start ?? currentYear));
const minYear = isDated ? Math.min(...items.map((i) => i.start!)) : 0;
const maxYear = isDated ? Math.max(...items.map(endYear)) : 0;
const rows = isDated ? maxYear - minYear + 1 : items.length;
const years = isDated ? Array.from({ length: rows }, (_, k) => minYear + k) : [];
const laneIndex = (l: string) => lanes.findIndex((x) => x.id === l);
const place = (i: TimelineItem, n: number) =>
  isDated
    ? `--row:${i.start! - minYear + 1} / ${endYear(i) - minYear + 2};--col:${laneIndex(i.lane) + 2}`
    : `--row:${n + 1};--col:${laneIndex(i.lane) + 2}`;
const cols = 'md:grid-cols-[4.5rem_repeat(3,minmax(0,1fr))] md:gap-x-8';
---
{!isDated && (
  <p class="mb-8 max-w-xl border border-dashed border-clay/60 px-5 py-4 text-sm italic text-ink-soft">
    [Dates and exact order are placeholders. Add start/end years in src/data/education.ts and
    experience.ts and the timeline will switch to a to-scale view with overlapping periods.]
  </p>
)}

<div class:list={['hidden border-b border-ink pb-3 md:grid', cols]}>
  <span></span>
  {lanes.map((l) => <p class="eyebrow">{l.label}</p>)}
</div>

<!-- One list: stacked on mobile, lane grid from md up -->
<ol
  class:list={['grid gap-y-8 md:gap-y-6 md:pt-6 md:[grid-template-rows:var(--rows)]', cols]}
  style={isDated ? `--rows:repeat(${rows},minmax(3.5rem,auto))` : undefined}
>
  {isDated
    ? years.map((y, k) => (
        <li aria-hidden="true" class="hidden text-sm tabular-nums text-ink-soft md:block md:[grid-column:1]" style={`grid-row:${k + 1}`}>{y}</li>
      ))
    : items.map((_, k) => (
        <li aria-hidden="true" class="todo hidden text-xs md:block md:[grid-column:1]" style={`grid-row:${k + 1}`}>[dates]</li>
      ))}
  {items.map((it, n) => (
    <li class="md:[grid-column:var(--col)] md:[grid-row:var(--row)]" style={place(it, n)}>
      <TimelineEntry item={it} showLane />
    </li>
  ))}
</ol>
