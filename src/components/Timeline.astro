---
import type { TimelineItem } from '~/lib/timeline';
import TimelineEntry from './TimelineEntry.astro';

/** Career timeline, most recent first. Period on the left, entry on the right. */
interface Props { items: TimelineItem[] }
const { items } = Astro.props;
---
<ol class="border-b border-warm/70">
  {items.map((it) => (
    <li class="border-t border-warm/70 py-6">
      <TimelineEntry item={it} showLane />
    </li>
  ))}
</ol>
