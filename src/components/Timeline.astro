---
import type { TimelineItem } from '~/lib/timeline';
import { lanes } from '~/lib/timeline';
import TimelineEntry from './TimelineEntry.astro';

/**
 * Reverse-chronological timeline drawn to scale: latest year first, each entry's bar starts and ends at its
 * real dates. Months are used where known; a year without a month is placed mid-year. Entries that overlap in
 * time inside one lane sit side by side. Entries without a start date are listed underneath.
 * (The earlier layout lives in TimelineClassic.astro.)
 */
interface Props { items: TimelineItem[] }
const { items } = Astro.props;

const now = new Date();
const nowT = now.getFullYear() + now.getMonth() / 12 + now.getDate() / 365;
const parse = (d: string, edge: 'start' | 'end') => {
  const [y, m] = d.split('-').map(Number);
  if (!m) return y + 0.5;
  return edge === 'start' ? y + (m - 1) / 12 : y + m / 12;
};
const dated = items.filter((i) => i.start !== null);
const undated = items.filter((i) => i.start === null);
const t0 = (i: TimelineItem) => parse(i.start!, 'start');
const t1 = (i: TimelineItem) => (i.end === 'present' ? nowT : parse(i.end ?? i.start!, 'end'));

const topYear = Math.floor(Math.max(nowT, ...dated.map(t1)));
const bottomYear = Math.floor(Math.min(...dated.map(t0)));
const years = Array.from({ length: topYear - bottomYear + 1 }, (_, k) => topYear - k);
const rem = 2.75; // height of one year
const T = topYear + 1;
const y = (t: number) => `${((T - t) * rem).toFixed(3)}rem`;
const totalH = `${((T - bottomYear) * rem).toFixed(3)}rem`;

// Place overlapping entries of a lane in separate sub-columns.
const subs: Record<string, TimelineItem[][]> = {};
for (const lane of lanes) {
  const cols: TimelineItem[][] = [];
  const laneItems = dated.filter((i) => i.lane === lane.id).sort((a, b) => t0(a) - t0(b) || a.order - b.order);
  for (const it of laneItems) {
    const col = cols.find((c) => t1(c[c.length - 1]) <= t0(it) + 1e-6);
    if (col) col.push(it); else cols.push([it]);
  }
  subs[lane.id] = cols.length ? cols : [[]];
}
const template = `3.5rem ${lanes.map((l) => `minmax(0, ${subs[l.id].length}fr)`).join(' ')}`;
const band: Record<string, string> = { education: 'bg-teal/[0.13]', industry: 'bg-clay/[0.11]', research: 'bg-warm/[0.38]' };
const headBar: Record<string, string> = { education: 'border-teal', industry: 'border-clay', research: 'border-warm' };
const mobile = [...dated].sort((a, b) => t1(b) - t1(a) || t0(b) - t0(a));
---
<!-- Small screens: a simple list, latest first -->
<ol class="border-b border-warm/70 xl:hidden">
  {[...mobile, ...undated].map((it) => (
    <li class="border-t border-warm/70 py-5"><TimelineEntry item={it} compact showPeriod /></li>
  ))}
</ol>

<!-- xl and up: lanes drawn to scale -->
<div class="hidden xl:block">
  <div class="grid gap-x-4" style={`grid-template-columns:${template}`}>
    <span></span>
    {lanes.map((l) => <p class:list={['eyebrow border-t-[3px] pt-2 pb-2', headBar[l.id]]}>{l.label}</p>)}
  </div>
  <div class="grid gap-x-4 border-t border-ink" style={`grid-template-columns:${template}`}>
    <div class="relative" style={`height:${totalH}`}>
      {years.map((yr) => (
        <p class="absolute inset-x-0 border-t border-warm/40 pt-1.5 text-sm tabular-nums text-ink-soft" style={`top:${y(yr + 1)}`}>{yr}</p>
      ))}
    </div>
    {lanes.map((l) => (
      <div class:list={['grid gap-x-3 px-2', band[l.id]]} style={`grid-template-columns:repeat(${subs[l.id].length}, minmax(0, 1fr));height:${totalH}`}>
        {subs[l.id].map((col) => (
          <div class="relative">
            {col.map((it) => (
              <div class="absolute inset-x-0" style={`top:${y(t1(it))};height:${((t1(it) - t0(it)) * rem).toFixed(3)}rem`}>
                <TimelineEntry item={it} compact />
              </div>
            ))}
          </div>
        ))}
      </div>
    ))}
  </div>
</div>

{undated.length > 0 && (
  <div class="mt-8 hidden xl:block">
    <p class="eyebrow mb-3">Dates to be added</p>
    <ul class="grid gap-x-5 md:grid-cols-3">
      {undated.map((it) => <li><TimelineEntry item={it} compact /></li>)}
    </ul>
  </div>
)}
