---
import type { TimelineItem } from '~/lib/timeline';
import { lanes, yearOf } from '~/lib/timeline';
import TimelineEntry from './TimelineEntry.astro';

/**
 * Reverse-chronological timeline drawn to scale: one row per year, latest year first, and every entry
 * spans the years it covers. Entries that overlap inside one lane are placed side by side.
 * Entries without a start date are listed underneath. (The earlier layout lives in TimelineClassic.astro.)
 */
interface Props { items: TimelineItem[] }
const { items } = Astro.props;

const currentYear = new Date().getFullYear();
const dated = items.filter((i) => i.start !== null);
const undated = items.filter((i) => i.start === null);
const endYear = (i: TimelineItem) => (i.end === 'present' ? currentYear : yearOf(i.end ?? i.start!));
const startYear = (i: TimelineItem) => yearOf(i.start!);
const maxYear = Math.max(currentYear, ...dated.map(endYear));
const minYear = Math.min(...dated.map(startYear));
const years = Array.from({ length: maxYear - minYear + 1 }, (_, k) => maxYear - k);

// Greedy packing of overlapping entries into sub-columns within each lane.
const placed: { item: TimelineItem; sub: number }[] = [];
const subCount: Record<string, number> = {};
for (const lane of lanes) {
  const laneItems = dated.filter((i) => i.lane === lane.id).sort((a, b) => startYear(a) - startYear(b) || a.order - b.order);
  const busyUntil: number[] = [];
  for (const it of laneItems) {
    let sub = busyUntil.findIndex((end) => end < startYear(it));
    if (sub === -1) { sub = busyUntil.length; busyUntil.push(0); }
    busyUntil[sub] = endYear(it);
    placed.push({ item: it, sub });
  }
  subCount[lane.id] = Math.max(1, busyUntil.length);
}
let col = 2;
const laneCol: Record<string, number> = {};
for (const lane of lanes) { laneCol[lane.id] = col; col += subCount[lane.id]; }
const totalCols = col - 2;
const template = `4rem repeat(${totalCols}, minmax(0, 1fr))`;
const rowOf = (y: number) => maxYear - y + 1;
const cell = (p: { item: TimelineItem; sub: number }) =>
  `grid-row:${rowOf(endYear(p.item))} / ${rowOf(startYear(p.item)) + 1};grid-column:${laneCol[p.item.lane] + p.sub}`;
const mobile = [...dated].sort((a, b) => endYear(b) - endYear(a) || startYear(b) - startYear(a));
---
<!-- Small screens: a simple list, latest first -->
<ol class="border-b border-warm/70 md:hidden">
  {[...mobile, ...undated].map((it) => (
    <li class="border-t border-warm/70 py-5"><TimelineEntry item={it} compact showPeriod /></li>
  ))}
</ol>

<!-- md and up: lanes by year -->
<div class="hidden md:block">
  <div class="grid gap-x-5 border-b border-ink pb-3" style={`grid-template-columns:${template}`}>
    <span></span>
    {lanes.map((l) => <p class="eyebrow" style={`grid-column:${laneCol[l.id]} / span ${subCount[l.id]}`}>{l.label}</p>)}
  </div>
  <div class="grid gap-x-5 pt-4" style={`grid-template-columns:${template};grid-template-rows:repeat(${years.length},minmax(4.25rem,auto))`}>
    {years.map((y, k) => (
      <p class="border-t border-warm/50 pt-2 text-sm tabular-nums text-ink-soft" style={`grid-row:${k + 1};grid-column:1`}>{y}</p>
    ))}
    {placed.map((p) => (
      <div class="pb-3 pt-2" style={cell(p)}><TimelineEntry item={p.item} compact /></div>
    ))}
  </div>
</div>

{undated.length > 0 && (
  <div class="mt-8 hidden md:block">
    <p class="eyebrow mb-3">Dates to be added</p>
    <ul class="grid gap-x-5 md:grid-cols-3">
      {undated.map((it) => <li><TimelineEntry item={it} compact /></li>)}
    </ul>
  </div>
)}
