---
import type { ProjectCardData } from '~/data/cards';
import ImagePlaceholder from './ImagePlaceholder.astro';

/**
 * Project card: category, title, description, then actions. "View project" is stretched over the
 * whole card; the Demo link sits above it so both stay clickable.
 */
interface Props {
  item: ProjectCardData;
  tone?: 'sage' | 'warm' | 'teal';
  /** 'lead' lays the image beside the text in a tinted panel. */
  variant?: 'tile' | 'lead';
  /** Small image beside the text on phones (tiles only). */
  compactMobile?: boolean;
}
const { item, tone = 'sage', variant = 'tile', compactMobile = false } = Astro.props;
const lead = variant === 'lead';
---
<article
  class:list={[
    'group relative flex h-full',
    lead ? 'flex-col gap-5 bg-paper-deep p-4 sm:p-5 md:flex-row md:items-center md:gap-8' : compactMobile ? 'gap-4 md:flex-col md:gap-0' : 'flex-col',
  ]}
>
  <div class:list={['overflow-hidden', lead ? 'md:w-1/3 md:shrink-0' : compactMobile ? 'w-[40%] shrink-0 md:w-full' : 'w-full']}>
    <div class="transition-transform duration-500 ease-out group-hover:scale-[1.03] [&_span.font-display]:text-base max-md:[&_span.font-display]:hidden">
      <ImagePlaceholder src={item.image.src} alt={item.image.alt} label={item.image.placeholderLabel} tone={tone} ratio="aspect-[16/10]" />
    </div>
  </div>
  <div class:list={['flex min-w-0 flex-1 flex-col', lead ? 'md:py-1' : compactMobile ? 'self-center md:mt-4 md:self-auto' : 'mt-4']}>
    <p class="eyebrow">{item.label}</p>
    <h3 class:list={['font-display mt-1.5 leading-snug transition-colors group-hover:text-teal', lead ? 'text-2xl' : 'text-lg sm:text-xl']}>{item.title}</h3>
    <p class:list={['mt-2 leading-relaxed text-ink-soft', lead ? 'max-w-xl text-[0.9375rem]' : 'text-[0.9rem]']}>{item.summary}</p>
    <p class="mt-auto flex min-h-[2.75rem] flex-wrap items-end gap-x-4 gap-y-2 pt-4 text-sm">
      <a
        href={item.href}
        aria-label={`View project: ${item.title}`}
        class="text-ink-soft transition-colors after:absolute after:inset-0 after:content-[''] group-hover:text-clay"
      >View project <span aria-hidden="true" class="inline-block transition-transform duration-300 group-hover:translate-x-1">→</span></a>
      {item.demoHref && (
        <a
          href={item.demoHref}
          aria-label={`Demo: ${item.title}`}
          class="relative z-10 border border-clay/60 bg-clay/10 px-2 py-0.5 text-xs text-clay transition-colors hover:bg-clay hover:text-paper"
        >Demo</a>
      )}
    </p>
  </div>
</article>
