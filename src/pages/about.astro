---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Container from '~/components/Container.astro';
import ImagePlaceholder from '~/components/ImagePlaceholder.astro';
import ContactLinks from '~/components/ContactLinks.astro';
import { site } from '~/data/site';
import { about } from '~/data/about';
import { education } from '~/data/education';
import { formatPeriod } from '~/lib/timeline';

// Entries without an institution or dates are left out until they are filled in.
const studies = [...education].reverse().filter((e) => e.institution || e.start);
const row = 'grid scroll-mt-24 gap-x-10 gap-y-4 lg:grid-cols-12';
const heading = 'font-display-tight text-xl font-light lg:col-span-2 lg:text-2xl';
---
<BaseLayout tightFooter title="About" description="A short introduction, education and contact details.">
  <Container class="pt-8 sm:pt-10">
    <h1 class="font-display-tight text-[clamp(1.75rem,3.2vw,2.5rem)] font-light" style="line-height:1.08">About</h1>
  </Container>

  <Container class="pt-8 sm:pt-10">
    <div class="grid gap-8 md:grid-cols-12 md:items-start md:gap-10">
      <div class="space-y-4 text-[1.0625rem] leading-[1.7] md:col-span-8 lg:col-span-7">
        {about.intro.map((p) => <p>{p}</p>)}
      </div>
      <div class="md:col-span-4 md:col-start-9 lg:col-span-3 lg:col-start-10">
        <ImagePlaceholder src={site.portrait.src} alt={site.portrait.alt} label={site.portrait.placeholderLabel} ratio="aspect-[4/5]" position="center 20%" class="max-w-[11rem] rounded-[3px] sm:max-w-[13rem] md:ml-auto md:max-w-[15rem]" />
      </div>
    </div>
  </Container>

  <section id="education" aria-labelledby="education-h" class="mt-12 sm:mt-14">
    <Container>
      <div class="border-t border-warm/70 pt-10">
        <div class={row}>
          <h2 id="education-h" class={heading}>Education</h2>
          <ul class="grid gap-x-8 gap-y-6 sm:grid-cols-3 lg:col-span-10">
            {studies.map((e) => (
              <li class="flex flex-col">
                <p class="text-sm tabular-nums text-clay">{formatPeriod(e)}</p>
                <p class="font-display mt-1 text-lg" style="line-height:1.25">{e.title}</p>
                <p class="mt-1 text-sm text-ink-soft">{e.institution}</p>
                {e.field && <p class="text-sm text-ink-soft">{e.field}</p>}
                {(e.thesis || e.achievement) && <p class="mt-1.5 text-[0.8125rem] leading-snug text-ink-soft">{[e.thesis, e.achievement].filter(Boolean).join(' · ')}</p>}
                {e.projects[0] && <p class="mt-auto pt-2 text-sm"><a href={`/projects/${e.projects[0]}`} class="link-line">View project →</a></p>}
              </li>
            ))}
          </ul>
        </div>
        <div class:list={[row, 'mt-6']}><p class="text-sm lg:col-span-10 lg:col-start-3"><a href="/journey" class="link-line">Academic and professional timeline →</a></p></div>
      </div>
    </Container>
  </section>

  <section id="contact" aria-labelledby="contact-h" class="mt-12 bg-teal py-10 text-paper sm:mt-14 lg:py-12 [&_.eyebrow]:!text-sage [&_.link-line]:!text-paper [&_.link-line:hover]:!text-sage [&_dl]:!divide-paper/20 [&_dl]:!border-y-0">
    <Container>
      <div class={row}>
        <h2 id="contact-h" class={heading}>Contact</h2>
        <div class="lg:col-span-10"><ContactLinks compact /></div>
      </div>
    </Container>
  </section>
</BaseLayout>
