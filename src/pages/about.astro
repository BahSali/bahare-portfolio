---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Container from '~/components/Container.astro';
import ImagePlaceholder from '~/components/ImagePlaceholder.astro';
import ContactLinks from '~/components/ContactLinks.astro';
import { site } from '~/data/site';
import { about } from '~/data/about';
import { education } from '~/data/education';
import { skills } from '~/data/skills';
import { formatPeriod } from '~/lib/timeline';

// Entries without an institution or dates are left out until they are filled in.
const studies = [...education].reverse().filter((e) => e.institution || e.start);
const filledSkills = skills.filter((g) => g.items.length > 0);
const row = 'grid scroll-mt-24 gap-x-10 gap-y-4 lg:grid-cols-12';
---
<BaseLayout tightFooter title="About" description="Professional introduction, education, skills and contact details.">
  <Container class="pt-8 sm:pt-10">
    <h1 class="font-display-tight text-[clamp(1.75rem,3.2vw,2.5rem)] font-light" style="line-height:1.08">About</h1>
    <p class="mt-2 text-sm text-ink-soft">{site.role} · {site.subtitle}</p>
  </Container>

  <Container class="pt-8 sm:pt-10">
    <div class="grid items-center gap-10 lg:grid-cols-12">
      <div class="space-y-5 text-[1.0625rem] leading-[1.7] lg:col-span-7">
        {about.intro.map((p) => <p>{p}</p>)}
      </div>
      <div class="lg:col-span-4 lg:col-start-9">
        <ImagePlaceholder src={site.portrait.src} alt={site.portrait.alt} label={site.portrait.placeholderLabel} ratio="aspect-[4/5]" position="center 20%" class="max-w-[17rem] rounded-[3px] lg:ml-auto" />
      </div>
    </div>
  </Container>

  <section id="education" class="mt-section-sm">
    <Container>
      <div class:list={[row, 'border-t border-warm/70 pt-8']}>
        <h2 class="eyebrow lg:col-span-2 lg:pt-1">Education</h2>
        <ul class="divide-y divide-warm/50 lg:col-span-10">
          {studies.map((e) => (
            <li class="grid gap-x-8 gap-y-0.5 py-3.5 first:pt-0 sm:grid-cols-[minmax(0,1fr)_13rem]">
              <div>
                <p class="font-display text-xl" style="line-height:1.25">{e.title}</p>
                <p class="mt-0.5 text-sm text-ink-soft">{e.institution}</p>
                {e.field && <p class="mt-0.5 text-sm text-ink-soft">{e.field}</p>}
                {e.achievement && <p class="mt-0.5 text-sm text-ink-soft">{e.achievement}</p>}
                {e.thesis && <p class="mt-0.5 text-sm text-ink-soft">{e.thesis}</p>}
              </div>
              <p class="text-sm tabular-nums text-ink-soft sm:text-right">{formatPeriod(e)}</p>
            </li>
          ))}
        </ul>
      </div>
      <div class="mt-4 grid gap-x-10 lg:grid-cols-12"><p class="text-sm lg:col-span-10 lg:col-start-3"><a href="/journey" class="link-line">Academic and professional timeline →</a></p></div>
    </Container>
  </section>

  <section id="skills" class="mt-section-sm bg-paper-deep py-section-sm">
    <Container>
      <div class={row}>
        <h2 class="eyebrow lg:col-span-2 lg:pt-1">Skills</h2>
        <div class="grid gap-x-8 gap-y-8 sm:grid-cols-2 lg:col-span-10 lg:grid-cols-4">
          {filledSkills.map((g) => (
            <div class="border-t border-ink pt-3">
              <h3 class="font-display text-lg" style="line-height:1.25">{g.title}</h3>
              <ul class="mt-2 space-y-1 text-sm text-ink-soft">{g.items.map((i) => <li>{i}</li>)}</ul>
            </div>
          ))}
        </div>
      </div>
    </Container>
  </section>

  <section id="contact" class="bg-teal py-section-sm text-paper [&_.eyebrow]:!text-sage [&_.link-line]:!text-paper [&_.link-line:hover]:!text-sage [&_dl]:!divide-paper/20 [&_dl]:!border-paper/20">
    <Container>
      <div class={row}>
        <h2 class="eyebrow lg:col-span-2 lg:pt-1">Contact</h2>
        <div class="lg:col-span-10 lg:max-w-[40rem]"><ContactLinks compact /></div>
      </div>
    </Container>
  </section>
</BaseLayout>
