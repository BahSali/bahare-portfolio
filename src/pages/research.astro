---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Container from '~/components/Container.astro';
import SectionNav from '~/components/SectionNav.astro';
import PlaceholderBlock from '~/components/PlaceholderBlock.astro';
import PublicationRow from '~/components/PublicationRow.astro';
import EventGallery from '~/components/EventGallery.astro';
import { research } from '~/data/research';
import { events } from '~/data/events';
import { publications } from '~/data/publications';
import { getProject } from '~/data/projects';

const byYear = [...publications].sort((a, b) => b.year - a.year);
const years = [...new Set(byYear.map((p) => p.year))];
const anchors = [
  ['Research Areas', '#focus'],
  ["Doctoral & Master's Research", '#academic'],
  ['Event Highlights', '#events'],
  ['Publications', '#publications'],
] as const;
// Each section is a full-width band; alternating tints separate them instead of rules.
const band = (tint: boolean) => ['scroll-mt-28 py-10 sm:py-12', tint && 'bg-paper-deep'];
const grid = 'grid gap-x-10 gap-y-5 lg:grid-cols-12';
const heading = 'font-display-tight text-xl font-light lg:col-span-3 lg:text-2xl';
---
<BaseLayout tightFooter title="Research" description="Research focus, doctoral and master's research, events and publications.">
  <Container class="pt-8 sm:pt-10">
    <h1 class="font-display-tight text-[clamp(1.75rem,3.2vw,2.5rem)] font-light" style="line-height:1.08">Research</h1>
  </Container>

  <SectionNav items={[...anchors]} />

  <section id="focus" class:list={band(false)}>
    <Container class={grid}>
      <h2 class={heading}>Research Areas</h2>
      <ul class="grid gap-x-8 gap-y-3 sm:grid-cols-2 lg:col-span-9">
        {research.interests.map((t) => (
          <li class="font-display flex items-baseline gap-3 text-lg" style="line-height:1.3">
            <span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 translate-y-[-0.15em] rounded-full bg-clay"></span>{t}
          </li>
        ))}
      </ul>
    </Container>
  </section>

  <section id="academic" class:list={band(true)}>
    <Container class={grid}>
      <h2 class={heading}>Doctoral & Master's Research</h2>
      <div class="grid gap-6 sm:grid-cols-2 lg:col-span-9">
        {research.academic.map((e) => {
          const p = getProject(e.project);
          return (
            <article class="bg-paper p-5">
              <h3 class="font-display text-lg" style="line-height:1.25">{e.title}</h3>
              <p class="mt-0.5 text-sm text-ink-soft">{e.institution}</p>
              <p class="mt-3 text-[0.9375rem] leading-[1.65]">{e.summary}</p>
              {p && <p class="mt-3 text-sm"><a href={`/projects/${p.slug}`} class="link-line">{p.title} →</a></p>}
            </article>
          );
        })}
      </div>
    </Container>
  </section>

  <section id="events" class:list={band(false)}>
    <Container class={grid}>
      <h2 class={heading}>Event Highlights</h2>
      <div class="lg:col-span-9"><EventGallery events={events} /></div>
    </Container>
  </section>

  <section id="publications" class:list={[...band(true), '']}>
    <Container class={grid}>
      <h2 class={heading}>Publications</h2>
      <div class="space-y-8 lg:col-span-9">
        {publications.length === 0
          ? <PlaceholderBlock>Publication list to be added in src/data/publications.ts</PlaceholderBlock>
          : years.map((y) => (
              <div class="grid gap-x-6 gap-y-2 sm:grid-cols-[3.5rem_1fr]">
                <h3 class="font-display text-xl text-clay" style="line-height:1.2">{y}</h3>
                <ol class="space-y-6">
                  {byYear.filter((p) => p.year === y).map((p) => <PublicationRow publication={p} showType hideYear />)}
                </ol>
              </div>
            ))}
      </div>
    </Container>
  </section>
</BaseLayout>
