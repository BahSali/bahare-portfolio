---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Container from '~/components/Container.astro';
import SectionNav from '~/components/SectionNav.astro';
import PlaceholderBlock from '~/components/PlaceholderBlock.astro';
import PublicationRow from '~/components/PublicationRow.astro';
import EventGallery from '~/components/EventGallery.astro';
import { research } from '~/data/research';
import { events } from '~/data/events';
import { publications } from '~/data/publications';
import { getProject } from '~/data/projects';

const byYear = [...publications].sort((a, b) => b.year - a.year);
const years = [...new Set(byYear.map((p) => p.year))];
const anchors = [
  ['Research Areas', '#focus'],
  ["Doctoral & Master's Research", '#academic'],
  ['Event Gallery', '#events'],
  ['Publications', '#publications'],
] as const;
const row = 'grid scroll-mt-28 gap-x-10 gap-y-4 border-t border-warm/70 py-8 lg:grid-cols-12';
---
<BaseLayout title="Research" description="Research focus, doctoral and master's research, events and publications.">
  <Container class="pt-8 sm:pt-10">
    <h1 class="font-display-tight text-[clamp(1.75rem,3.2vw,2.5rem)] font-light" style="line-height:1.08">Research</h1>
  </Container>

  <SectionNav items={[...anchors]} />

  <Container class="pb-12">
    <section id="focus" class="grid scroll-mt-28 gap-x-10 gap-y-4 py-8 lg:grid-cols-12">
      <h2 class="eyebrow lg:col-span-2 lg:pt-1">Research Areas</h2>
      <ul class="divide-y divide-warm/50 lg:col-span-10">
        {research.interests.map((t) => <li class="font-display py-3 text-lg sm:text-xl" style="line-height:1.3">{t}</li>)}
      </ul>
    </section>

    <section id="academic" class={row}>
      <h2 class="eyebrow lg:col-span-2 lg:pt-1">Doctoral & Master's Research</h2>
      <div class="grid gap-x-8 gap-y-8 sm:grid-cols-2 lg:col-span-10">
        {research.academic.map((e) => {
          const p = getProject(e.project);
          return (
            <article class="border-t border-warm/70 pt-3">
              <h3 class="font-display text-lg" style="line-height:1.25">{e.title}</h3>
              <p class="mt-0.5 text-sm text-ink-soft">{e.institution}</p>
              <p class="mt-2 text-[0.9375rem] leading-[1.65]">{e.summary}</p>
              {p && <p class="mt-3 text-sm"><a href={`/projects/${p.slug}`} class="link-line">{p.title} →</a></p>}
            </article>
          );
        })}
      </div>
    </section>

    <section id="events" class={row}>
      <h2 class="eyebrow lg:col-span-2 lg:pt-1">Event Gallery</h2>
      <div class="lg:col-span-10"><EventGallery events={events} /></div>
    </section>

    <section id="publications" class={row}>
      <h2 class="eyebrow lg:col-span-2 lg:pt-1">Publications</h2>
      <div class="lg:col-span-10">
        {publications.length === 0
          ? <PlaceholderBlock>Publication list to be added in src/data/publications.ts</PlaceholderBlock>
          : years.map((y) => (
              <div>
                <h3 class="eyebrow border-b border-ink pb-2 pt-4">{y}</h3>
                <ol class="divide-y divide-warm/70">
                  {byYear.filter((p) => p.year === y).map((p) => <PublicationRow publication={p} showType hideYear />)}
                </ol>
              </div>
            ))}
      </div>
    </section>
  </Container>
</BaseLayout>
