---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/PageHeader.astro';
import PageSection from '~/components/PageSection.astro';
import SectionNav from '~/components/SectionNav.astro';
import PlaceholderBlock from '~/components/PlaceholderBlock.astro';
import PublicationRow from '~/components/PublicationRow.astro';
import EventGallery from '~/components/EventGallery.astro';
import { research } from '~/data/research';
import { events } from '~/data/events';
import { publications } from '~/data/publications';
import { getProject } from '~/data/projects';

const byYear = [...publications].sort((a, b) => b.year - a.year);
const years = [...new Set(byYear.map((p) => p.year))];
const anchors = [
  ['Research Focus', '#focus'],
  ["Doctoral & Master's Research", '#academic'],
  ['Research Events & Gallery', '#events'],
  ['Publications', '#publications'],
] as const;
---
<BaseLayout title="Research" description="Research focus, doctoral and master's research, events and publications.">
  <PageHeader eyebrow="Research" title="Research">
    <p>Research interests, academic work and publications across machine learning, spatiotemporal modeling and optimization.</p>
  </PageHeader>

  <SectionNav items={[...anchors]} />

  <PageSection id="focus" eyebrow="Research Focus" title="What I work on">
    <ul class="divide-y divide-warm/70 border-y border-warm/70">
      {research.interests.map((t) => <li class="font-display py-3 text-xl sm:text-2xl" style="line-height:1.2">{t}</li>)}
    </ul>
    <p class="mt-6 max-w-xl text-ink-soft">{research.statement}</p>
  </PageSection>

  <PageSection id="academic" eyebrow="Academic research" title="Doctoral & Master's Research">
    <div class="space-y-10">
      {research.academic.map((e) => {
        const p = getProject(e.project);
        return (
          <article>
            <h3 class="font-display text-2xl" style="line-height:1.2">{e.title}</h3>
            <p class="mt-1 text-sm text-ink-soft">{e.institution}</p>
            <p class="mt-3 text-ink-soft">{e.summary}</p>
            {p && <p class="mt-3 text-sm"><a href={`/projects/${p.slug}`} class="link-line">{p.title} →</a></p>}
          </article>
        );
      })}
    </div>
  </PageSection>

  <PageSection id="events" eyebrow="Events" title="Research Events & Gallery">
    <EventGallery events={events} />
  </PageSection>

  <PageSection id="publications" eyebrow="Publications" title="Publications" class="pb-0">
    {publications.length === 0
      ? <PlaceholderBlock>Publication list to be added in src/data/publications.ts</PlaceholderBlock>
      : years.map((y) => (
          <div>
            <h3 class="eyebrow border-b border-ink pb-2 pt-4">{y}</h3>
            <ol class="divide-y divide-warm/70">
              {byYear.filter((p) => p.year === y).map((p) => <PublicationRow publication={p} showType hideYear />)}
            </ol>
          </div>
        ))}
  </PageSection>
</BaseLayout>
