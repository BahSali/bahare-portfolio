---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Container from '~/components/Container.astro';
import Timeline from '~/components/Timeline.astro';
import TimelineClassic from '~/components/TimelineClassic.astro';
import { timelineItems, reverseTimeline } from '~/lib/timeline';
---
<BaseLayout title="Journey" description="Academic and professional journey, from undergraduate studies to a PhD, with industrial experience in enterprise databases and ERP systems.">
  <Container class="pt-8 sm:pt-10">
    <h1 class="font-display-tight text-[clamp(1.75rem,3.2vw,2.5rem)] font-light" style="line-height:1.08">Journey</h1>
    <p class="mt-2 text-sm text-ink-soft">Education, research and industry experience, most recent first.</p>
  </Container>

  <Container class="pt-10">
    {reverseTimeline ? <Timeline items={timelineItems} /> : <TimelineClassic items={timelineItems} />}
  </Container>

</BaseLayout>
