---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Container from '~/components/Container.astro';
import PageHeader from '~/components/PageHeader.astro';
import Timeline from '~/components/Timeline.astro';
import { timelineItems } from '~/lib/timeline';
---
<BaseLayout title="Journey" description="Academic and professional journey, from a master's degree to a PhD, with industrial experience in enterprise databases and ERP systems.">
  <PageHeader eyebrow="Journey" title="Academic and professional journey">
    <p>Studies, research roles and industry work, most recent first.</p>
    <p class="mt-3 text-sm"><a href="/projects/emeralds" class="link-line">EMERALDS project</a> · <a href="/projects/enterprise-data-erp" class="link-line">Enterprise databases and ERP</a></p>
  </PageHeader>

  <Container class="pt-8">
    <Timeline items={timelineItems} />
  </Container>

</BaseLayout>
