---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Container from '~/components/Container.astro';
import ImagePlaceholder from '~/components/ImagePlaceholder.astro';
import Placeholder from '~/components/Placeholder.astro';
import { projects, categoryLabels } from '~/data/projects';
import type { Project } from '~/data/projects';
import { publications } from '~/data/publications';
import { timelineItems } from '~/lib/timeline';
import { Image, getImage } from 'astro:assets';
import CaseStudy from '~/components/CaseStudy.astro';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props { project: Project }
const { project } = Astro.props;
const app = project.application;
const briefBig = project.brief?.figure?.src ? (await getImage({ src: project.brief.figure.src, width: Math.min(project.brief.figure.src.width, 2000), format: 'png' })).src : null;
const briefFigs = await Promise.all(
  (project.brief?.figures ?? []).map(async (f) => ({
    ...f,
    big: (await getImage({ src: f.src, width: Math.min(f.src.width, 2000), format: 'png' })).src,
  })),
);
const thesisSections = await Promise.all(
  (project.brief?.sections ?? []).map(async (s) => ({
    ...s,
    blocks: await Promise.all(
      s.blocks.map(async (b) =>
        b.kind === 'text' && b.figure
          ? { ...b, figure: { ...b.figure, big: (await getImage({ src: b.figure.src, width: Math.min(b.figure.src.width, 2000), format: 'png' })).src } }
          : b.kind === 'columns'
            ? {
                ...b,
                items: await Promise.all(
                  b.items.map(async (it) =>
                    it.details?.figure
                      ? { ...it, details: { ...it.details, figure: { ...it.details.figure, big: (await getImage({ src: it.details.figure.src, width: Math.min(it.details.figure.src.width, 2000), format: 'png' })).src } } }
                      : it,
                  ),
                ),
              }
            : b,
      ),
    ),
  })),
);
const story = project.story;

const related = publications.filter(
  (p) => project.publications.includes(p.slug) || p.projects?.includes(project.slug),
);
const context = timelineItems.filter((i) => i.projects.includes(project.slug));

const sections = story
  ? [
      { id: 'overview', label: 'Overview' },
      { id: 'methods', label: 'Technical Experience' },
      ...(app ? [{ id: 'application', label: 'Application Demo' }] : []),
      { id: 'journey', label: 'Research Journey' },
      { id: 'data', label: 'Data' },
      { id: 'publications', label: 'Publications' },
      { id: 'funding', label: 'Funding' },
    ]
  : [
      { id: 'overview', label: 'Overview' },
      { id: 'methodology', label: 'Methodology' },
      { id: 'results', label: 'Results' },
      ...(app ? [{ id: 'application', label: 'Interactive application' }] : []),
      { id: 'publications', label: 'Related publications' },
    ];
const row = 'grid scroll-mt-28 gap-3 border-t border-warm/70 py-8 lg:grid-cols-12 lg:gap-10';
const toggle =
  'group/d border-t border-warm/70 py-3 [&>summary]:flex [&>summary]:cursor-pointer [&>summary]:list-none [&>summary]:items-center [&>summary]:justify-between [&>summary::-webkit-details-marker]:hidden';
---
<BaseLayout tightFooter={!!story} title={project.headline ?? project.title} description={project.subtitle ? `${project.headline}. ${project.subtitle}.` : project.summary}>
  <Container class="pt-8 sm:pt-10">
    <p class="text-sm"><a href="/projects" class="link-line">← All projects</a></p>
    <div class="mt-6 grid gap-4 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-12">
        <p class="eyebrow mb-3">{project.eyebrow ?? categoryLabels[project.category]}</p>
        <h1 class="font-display-tight text-[clamp(1.5rem,2.9vw,2.25rem)] font-light" style="line-height:1.1">{project.headline ?? project.title}</h1>
      </div>
      {project.subtitle
        ? <p class="text-sm text-ink-soft lg:col-span-12 lg:-mt-2"><span class="eyebrow mr-3">Research areas</span>{project.subtitle}</p>
        : !project.brief && <p class="max-w-md text-ink-soft lg:col-span-4 lg:col-start-9">{project.summary}</p>}
    </div>

    <dl class:list={["mt-6 grid gap-x-10 gap-y-3 border-y border-warm/70 py-4 text-sm", story || project.brief ? "sm:grid-cols-2" : "sm:grid-cols-3"]}>
      <div><dt class="eyebrow mb-1">Period</dt><dd>{project.period ?? <Placeholder>Period to be added</Placeholder>}</dd></div>
      <div><dt class="eyebrow mb-1">Role</dt><dd>{project.role ?? <Placeholder>Role to be added</Placeholder>}</dd></div>
      {!story && !project.brief && <div>
        <dt class="eyebrow mb-1">Context</dt>
        <dd>
          {context.length
            ? context.map((c, i) => <>{i > 0 && ', '}<a href={c.href ?? `/journey#${c.id}`} class="link-line">{c.title}</a></>)
            : <Placeholder>Context to be added</Placeholder>}
        </dd>
      </div>}
    </dl>

    {!story && !project.brief && <ImagePlaceholder src={project.image.src} alt={project.image.alt} label={project.image.placeholderLabel} tone="sage" ratio="aspect-[16/7]" eager class="mt-6" />}
  </Container>

  {!project.brief && <nav aria-label="Sections" class="sticky top-[60px] z-30 mt-8 border-y border-warm/70 bg-paper/95 backdrop-blur-sm">
    <Container>
      <ul id="section-nav" class="flex gap-6 overflow-x-auto py-3 text-sm whitespace-nowrap">
        {sections.map((s) => (
          <li>
            <a
              href={`#${s.id}`}
              data-text={s.label}
              class="inline-flex flex-col text-ink-soft transition-colors after:invisible after:h-0 after:overflow-hidden after:font-semibold after:content-[attr(data-text)] hover:text-clay aria-[current=true]:font-semibold aria-[current=true]:text-ink"
            >{s.label}</a>
          </li>
        ))}
      </ul>
    </Container>
  </nav>}

  {project.brief?.sections && (
    <Container class="pb-12 pt-2">
      {thesisSections.map((s) => (
        <section id={s.id} class="grid scroll-mt-28 gap-x-10 gap-y-4 border-t border-warm/70 py-7 first:mt-6 lg:grid-cols-12">
          <h2 class="eyebrow lg:col-span-2 lg:pt-1">{s.title}</h2>
          <div class="space-y-8 lg:col-span-10">
            {s.blocks.map((b) => {
              if (b.kind === 'text') {
                return (
                  <div class:list={['grid items-start gap-x-10 gap-y-5', b.figure && (b.figureFirst ? 'md:grid-cols-[16rem_minmax(0,1fr)]' : 'md:grid-cols-[minmax(0,1fr)_16rem]')]}>
                    <div class:list={['space-y-3 text-justify text-base leading-[1.7] hyphens-auto', b.figureFirst && 'md:order-2']}>
                      {b.lead && <p class="font-display text-xl text-teal" style="line-height:1.3">{b.lead}</p>}
                      {b.paragraphs.map((t) => <p>{t}</p>)}
                    </div>
                    {b.figure && (
                      <figure class:list={['w-full max-w-[16rem]', b.figureFirst && 'md:order-1']}>
                        <button type="button" data-lightbox={b.figure.big} data-alt={b.figure.alt} class="group flex h-48 w-full cursor-zoom-in items-center justify-center border border-warm/70 bg-paper" aria-label="Enlarge figure">
                          <Image src={b.figure.src} alt={b.figure.alt} format="png" quality="high" width={640} class="h-auto max-h-full w-auto max-w-full p-2 transition-opacity group-hover:opacity-90" loading="lazy" />
                        </button>
                        <figcaption class="mt-2 text-xs leading-snug text-ink-soft">{b.figure.caption} <button type="button" data-lightbox={b.figure.big} data-alt={b.figure.alt} class="underline underline-offset-4 hover:text-clay">Enlarge</button></figcaption>
                      </figure>
                    )}
                  </div>
                );
              }
              if (b.kind === 'columns') {
                return (
                  <div class="grid gap-x-8 gap-y-5 md:grid-cols-3">
                    {b.items.map((it) => (
                      <div class="border-t border-warm/70 pt-3">
                        <h3 class="font-display text-lg" style="line-height:1.25">{it.label}</h3>
                        <p class="mt-2 text-justify text-[0.9375rem] leading-[1.65] text-ink-soft hyphens-auto">{it.parts ? it.parts.map((x) => typeof x === 'string' ? x : <a href={x.href} target="_blank" rel="noopener noreferrer" class="link-line">{x.text}</a>) : it.text}</p>
                        {it.details && (
                          <details class="group/d mt-3 border-t border-warm/70 pt-2 [&>summary]:flex [&>summary]:cursor-pointer [&>summary]:list-none [&>summary]:items-center [&>summary]:justify-between [&>summary::-webkit-details-marker]:hidden">
                            <summary class="text-sm text-ink-soft transition-colors hover:text-clay"><span>{it.details.summary}</span><span aria-hidden="true" class="transition-transform group-open/d:rotate-45">+</span></summary>
                            <div class="mt-3 space-y-3">
                              {it.details.items.map((d) => (
                                <div>
                                  <h4 class="eyebrow mb-1">{d.title}</h4>
                                  <p class="text-justify text-[0.875rem] leading-[1.6] text-ink-soft hyphens-auto">{d.text}</p>
                                </div>
                              ))}
                              {it.details.figure && (
                                <figure>
                                  <button type="button" data-lightbox={it.details.figure.big} data-alt={it.details.figure.alt} class="group flex w-full cursor-zoom-in items-center justify-center border border-warm/70 bg-paper" aria-label="Enlarge figure">
                                    <Image src={it.details.figure.src} alt={it.details.figure.alt} format="png" quality="high" width={640} class="h-auto max-h-52 w-auto max-w-full p-2 transition-opacity group-hover:opacity-90" loading="lazy" />
                                  </button>
                                  <figcaption class="mt-2 text-xs leading-snug text-ink-soft">{it.details.figure.caption} <button type="button" data-lightbox={it.details.figure.big} data-alt={it.details.figure.alt} class="underline underline-offset-4 hover:text-clay">Enlarge</button></figcaption>
                                </figure>
                              )}
                            </div>
                          </details>
                        )}
                      </div>
                    ))}
                  </div>
                );
              }
              if (b.kind === 'rows') {
                return (
                  <ul class="divide-y divide-warm/70 border-y border-warm/70">
                    {b.items.map((it) => (
                      <li class="grid gap-x-6 gap-y-1 py-3 sm:grid-cols-[13rem_1fr]">
                        <span class="font-display text-base">{it.label}</span>
                        <span class="text-justify text-[0.9375rem] leading-[1.6] text-ink-soft hyphens-auto">{it.text}</span>
                      </li>
                    ))}
                  </ul>
                );
              }
              return related.length > 0 && (
                <ul class="divide-y divide-warm/70 border-y border-warm/70 text-sm">
                  {related.map((pb) => (
                    <li class="py-2.5">
                      <a href={`/research#pub-${pb.slug}`} class="group grid gap-x-4 sm:grid-cols-[6rem_1fr]">
                        <span class="eyebrow whitespace-nowrap pt-0.5">{pb.venue.split(',')[0]}</span>
                        <span class="font-display leading-snug transition-colors group-hover:text-teal">{pb.title}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              );
            })}
          </div>
        </section>
      ))}
    </Container>
  )}

  {project.brief && !project.brief.sections && (
    <Container class="pb-10 pt-2">
      <div class="grid gap-x-12 gap-y-8 pt-8 lg:grid-cols-12">
      <div class="max-w-[42rem] space-y-8 lg:col-span-7">
        <section id="overview">
          <h2 class="eyebrow mb-3">Overview</h2>
          <div class="space-y-3 text-base leading-[1.7]">{project.brief.overview.length ? project.brief.overview.map((t) => <p>{t}</p>) : <p class="text-ink-soft"><Placeholder>Overview to be added</Placeholder></p>}</div>
        </section>
        {project.brief.contribution.length > 0 && (
          <section id="contribution">
            <h2 class="eyebrow mb-3">My Contribution</h2>
            <div class="space-y-3 text-base leading-[1.7]">{project.brief.contribution.map((t) => <p>{t}</p>)}</div>
          </section>
        )}
        {project.brief.extra?.map((ex) => (
          <section>
            <h2 class="eyebrow mb-3">{ex.title}</h2>
            <ul class="space-y-2.5 text-base leading-[1.65]">
              {ex.lines.map((l) => <li>{l.label && <span class="font-display mr-1.5">{l.label}:</span>}{l.text}</li>)}
            </ul>
          </section>
        ))}
        {project.links.length > 0 && (
          <p class="text-sm">{project.links.map((l) => <a href={l.href} class="link-line">{l.label}</a>)}</p>
        )}
        <section id="technical-areas">
          <h2 class="eyebrow mb-3">{project.brief.areaTitle}</h2>
          <p class="text-sm text-ink-soft">{project.brief.areas.length ? project.brief.areas.join(' · ') : <Placeholder>Skills to be added</Placeholder>}</p>
        </section>
        {related.length > 0 && (
          <section id="publications">
            <h2 class="eyebrow mb-3">Publications</h2>
            <ul class="divide-y divide-warm/70 border-y border-warm/70 text-sm">
              {related.map((pb) => (
                <li class="py-2.5">
                  <a href={`/research#pub-${pb.slug}`} class="group grid gap-x-4 sm:grid-cols-[6rem_1fr]">
                    <span class="eyebrow whitespace-nowrap pt-0.5">{pb.venue.split(',')[0]}</span>
                    <span class="font-display leading-snug transition-colors group-hover:text-teal">{pb.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>
      {briefFigs.length > 0 && (
        <div class="space-y-4 lg:col-span-5">
          {briefFigs.map((f) => (
            <figure>
              <button type="button" data-lightbox={f.big} data-alt={f.alt} class="group block w-full cursor-zoom-in border border-warm/70 bg-paper" aria-label="Enlarge figure">
                <Image src={f.src} alt={f.alt} format="png" quality="high" width={640} class="mx-auto h-auto max-h-[17rem] w-auto max-w-full p-1.5 transition-opacity group-hover:opacity-90" loading="lazy" />
              </button>
              <figcaption class="mt-2 text-xs leading-snug text-ink-soft">{f.caption} <button type="button" data-lightbox={f.big} data-alt={f.alt} class="underline underline-offset-4 hover:text-clay">Enlarge figure</button></figcaption>
            </figure>
          ))}
        </div>
      )}
      {project.brief.figure && (
        <figure class="lg:col-span-5">
          {project.brief.figure.src
            ? <button type="button" data-lightbox={briefBig} data-alt={project.brief.figure.alt} class="group block w-full cursor-zoom-in border border-warm/70 bg-white" aria-label="Enlarge figure"><Image src={project.brief.figure.src} alt={project.brief.figure.alt} format="png" quality="high" width={640} class="h-auto w-full p-1.5 transition-opacity group-hover:opacity-90" loading="lazy" /></button>
            : <ImagePlaceholder src={null} alt={project.brief.figure.alt} label={project.brief.figure.placeholderLabel} tone="sage" ratio="aspect-[4/3]" />}
          <figcaption class="mt-2 text-xs leading-snug text-ink-soft">{project.brief.figure.caption} <button type="button" data-lightbox={briefBig} data-alt={project.brief.figure.alt} class="underline underline-offset-4 hover:text-clay">Enlarge figure</button></figcaption>
        </figure>
      )}
      </div>
    </Container>
  )}

  {story && <CaseStudy project={project} story={story} />}

  {!story && !project.brief && <Container class="pt-2">
    <section id="overview" class={row}>
      <h2 class="eyebrow lg:col-span-3">Overview</h2>
      <div class="max-w-2xl lg:col-span-8">
        {project.overview ? <p class="text-lg">{project.overview}</p> : <p class="text-ink-soft"><Placeholder>Overview to be added</Placeholder></p>}
        <div class="mt-6">
          <details class={toggle}>
            <summary class="text-sm"><span class="eyebrow">My contribution</span><span aria-hidden="true" class="text-ink-soft transition-transform group-open/d:rotate-45">+</span></summary>
            <p class="mt-3 text-ink-soft">{project.contributions.length ? project.contributions.join(' ') : <Placeholder>Personal contribution to be added</Placeholder>}</p>
          </details>
          <details class={`${toggle} border-b`}>
            <summary class="text-sm"><span class="eyebrow">Technologies</span><span aria-hidden="true" class="text-ink-soft transition-transform group-open/d:rotate-45">+</span></summary>
            <p class="mt-3 text-ink-soft">{project.technologies.length ? project.technologies.join(' · ') : <Placeholder>Technologies to be added</Placeholder>}</p>
          </details>
        </div>
      </div>
    </section>

    <section id="methodology" class={row}>
      <h2 class="eyebrow lg:col-span-3">Methodology</h2>
      <div class="max-w-2xl lg:col-span-8">
        {project.methodology ? <p class="text-lg">{project.methodology}</p> : <p class="text-ink-soft"><Placeholder>Methodology to be added</Placeholder></p>}
      </div>
    </section>

    <section id="results" class={row}>
      <h2 class="eyebrow lg:col-span-3">Results</h2>
      <div class="max-w-2xl lg:col-span-8">
        {project.results ? <p class="text-lg">{project.results}</p> : <p class="text-ink-soft"><Placeholder>Results to be added</Placeholder></p>}
        {project.links.length > 0 && (
          <p class="mt-5 flex flex-wrap gap-x-6 gap-y-1 text-sm">
            {project.links.map((l) => <a href={l.href} class="link-line">{l.label}</a>)}
          </p>
        )}
      </div>
    </section>

    {app && (
      <section id="application" class="scroll-mt-28 border-t border-warm/70 py-8">
        <div class="bg-paper-deep p-5 sm:p-8">
          <div class="grid gap-4 lg:grid-cols-12 lg:items-end lg:gap-10">
            <div class="lg:col-span-8">
              <p class="eyebrow mb-3">Interactive application</p>
              <h2 class="font-display-tight text-xl font-light sm:text-2xl" style="line-height:1.1">{app.title}</h2>
              <p class="mt-3 max-w-xl text-ink-soft">{app.summary}</p>
            </div>
            <p class="lg:col-span-4 lg:text-right">
              {app.demoUrl
                ? <a href={app.demoUrl} class="inline-block border border-teal bg-teal px-6 py-3 text-[0.9375rem] text-paper transition-colors hover:border-teal-deep hover:bg-teal-deep">Open live demo →</a>
                : <span class="inline-block border border-dashed border-clay/60 px-5 py-3 text-sm italic text-ink-soft">[Demo link to be added]</span>}
            </p>
          </div>
          {app.screenshots.length > 0 && (
            <div class="mt-6 grid gap-4 md:grid-cols-3 md:items-start">
              {app.screenshots.map((s, i) => (
                <ImagePlaceholder
                  src={s.src}
                  alt={s.alt}
                  label={s.placeholderLabel}
                  tone={i === 0 ? 'teal' : i === 1 ? 'sage' : 'warm'}
                  ratio="aspect-[16/10]"
                  class={i === 0 ? 'md:col-span-2 md:row-span-2' : ''}
                />
              ))}
            </div>
          )}
        </div>
      </section>
    )}

    <section id="publications" class={`${row} border-b`}>
      <h2 class="eyebrow lg:col-span-3">Related publications</h2>
      <div class="lg:col-span-8">
        {related.length
          ? <ul class="space-y-3">{related.map((p) => <li>{p.title} <span class="text-ink-soft">({p.year})</span></li>)}</ul>
          : <p class="text-ink-soft"><Placeholder>Related publications to be linked</Placeholder></p>}
        <p class="mt-4 text-sm"><a href="/research#publications" class="link-line">All publications →</a></p>
      </div>
    </section>
  </Container>}

  {(project.brief?.figure?.src || briefFigs.length > 0 || thesisSections.length > 0) && (
    <dialog id="lightbox" class="m-auto max-h-[92vh] max-w-[min(96vw,64rem)] bg-white p-3 backdrop:bg-ink/60">
      <form method="dialog" class="mb-2 text-right"><button class="text-sm underline underline-offset-4">Close</button></form>
      <img id="lightbox-img" alt="" class="h-auto max-h-[80vh] w-full object-contain" />
    </dialog>
  )}
</BaseLayout>

<script>
  const nav = document.getElementById('section-nav');
  if (nav) {
    const links = [...nav.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')];
    const targets = links.map((a) => document.getElementById(a.getAttribute('href')!.slice(1)));
    let current = -1;
    const update = () => {
      const line = 140;
      let idx = -1;
      targets.forEach((t, i) => { if (t && t.getBoundingClientRect().top <= line) idx = i; });
      const last = targets[targets.length - 1];
      if (last && innerHeight + scrollY >= document.documentElement.scrollHeight - 4 && last.getBoundingClientRect().top < innerHeight - 120) idx = links.length - 1;
      if (idx === current) return;
      current = idx;
      links.forEach((a, i) => a.setAttribute('aria-current', String(i === idx)));
      if (idx >= 0) {
        const a = links[idx];
        nav.scrollTo({ left: a.offsetLeft - 24, behavior: 'smooth' });
      }
    };
    addEventListener('scroll', update, { passive: true });
    addEventListener('resize', update);
    update();
  }
</script>

<script>
  const lb = document.getElementById('lightbox') as HTMLDialogElement | null;
  const lbImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
  if (lb && lbImg) {
    document.querySelectorAll<HTMLButtonElement>('[data-lightbox]').forEach((b) =>
      b.addEventListener('click', () => { lbImg.src = b.dataset.lightbox!; lbImg.alt = b.dataset.alt ?? ''; lb.showModal(); }),
    );
    lb.addEventListener('click', (e) => { if (e.target === lb) lb.close(); });
  }
</script>
