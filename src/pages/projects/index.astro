---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Container from '~/components/Container.astro';
import ImagePlaceholder from '~/components/ImagePlaceholder.astro';
import ProjectTile from '~/components/ProjectTile.astro';
import { projects, projectCard, categoryLabels } from '~/data/projects';

const lead = projects.filter((p) => p.tier === 'lead');
const others = projects.filter((p) => p.tier !== 'lead');
const tones = ['warm', 'teal', 'sage'] as const;
---
<BaseLayout title="Projects" description="Four research projects in machine learning, spatiotemporal modeling and optimization.">
  <Container class="pt-8 sm:pt-10">
    <div>
      <div>
        <p class="eyebrow mb-3">Projects</p>
        <h1 class="font-display-tight text-[clamp(1.75rem,3.2vw,2.5rem)] font-light" style="line-height:1.08">Research projects</h1>
      </div>

    </div>
  </Container>

  {lead.map((p) => (
    <Container class="pt-6 sm:pt-8">
      <a href={`/projects/${p.slug}`} class="group grid items-center gap-5 bg-paper-deep p-4 sm:p-5 md:grid-cols-12 md:gap-8">
        <div class="overflow-hidden md:col-span-4">
          <div class="transition-transform duration-500 ease-out group-hover:scale-[1.02] [&_span.font-display]:text-base">
            <ImagePlaceholder src={(p.cardImage ?? p.image).src} alt={(p.cardImage ?? p.image).alt} label={(p.cardImage ?? p.image).placeholderLabel} tone="sage" ratio="aspect-[16/10]" />
          </div>
        </div>
        <div class="md:col-span-8">
          <p class="eyebrow">{categoryLabels[p.category]}</p>
          <h2 class="font-display mt-2 text-2xl font-normal transition-colors group-hover:text-teal" style="line-height:1.15">{p.headline ?? p.title}</h2>
          <p class="mt-2 max-w-xl text-[0.9375rem] leading-snug text-ink-soft">{p.summary}</p>
          {(p.funding || p.application) && (
            <p class="mt-3 flex flex-wrap gap-2 text-xs">
              {p.funding && <span class="border border-teal/50 px-2 py-0.5 text-teal">{p.funding}</span>}
              {p.application && <span class="border border-clay/60 bg-clay/10 px-2 py-0.5 text-clay">Live demo</span>}
            </p>
          )}
          <p class="mt-3 text-sm text-ink-soft transition-colors group-hover:text-clay">
            View project <span aria-hidden="true" class="inline-block transition-transform duration-300 group-hover:translate-x-1">→</span>
          </p>
        </div>
      </a>
    </Container>
  ))}

  <Container class="pt-8 sm:pt-10">
    <p class="eyebrow mb-5 border-t border-warm/70 pt-4">Further research</p>
    <div class="grid gap-6 md:grid-cols-3 md:gap-6">
      {others.map((p, i) => <ProjectTile item={projectCard(p)} tone={tones[i % tones.length]} />)}
    </div>
  </Container>
</BaseLayout>
