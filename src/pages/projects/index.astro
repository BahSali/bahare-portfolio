---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Container from '~/components/Container.astro';
import PageHeader from '~/components/PageHeader.astro';
import ProjectFeature from '~/components/ProjectFeature.astro';
import ProjectMedium from '~/components/ProjectMedium.astro';
import ProjectRow from '~/components/ProjectRow.astro';
import { projects } from '~/data/projects';

const lead = projects.filter((p) => p.tier === 'lead');
const standard = projects.filter((p) => p.tier === 'standard');
const minor = projects.filter((p) => p.tier === 'minor');
const tones = ['warm', 'sage', 'teal'] as const;
---
<BaseLayout title="Projects" description="Technical and research projects in machine learning, spatiotemporal modeling, optimization and data systems.">
  <PageHeader eyebrow="Projects" title="Technical and research projects">
    <p>Research and applied work in machine learning, spatiotemporal modeling, optimization and data systems.</p>
  </PageHeader>

  <Container class="pt-section-sm">
    <div class="space-y-20 sm:space-y-28 lg:space-y-32">
      {lead.map((p, i) => <ProjectFeature project={p} index={i} reversed={i % 2 === 1} />)}
    </div>
  </Container>

  {standard.length > 0 && (
    <Container class="pt-section-sm">
      <p class="eyebrow mb-8 border-t border-warm/70 pt-6">Further work</p>
      <div class="space-y-14">
        {standard.map((p, i) => <ProjectMedium project={p} tone={tones[i % tones.length]} />)}
      </div>
    </Container>
  )}

  {minor.length > 0 && (
    <Container class="pt-section-sm">
      <p class="eyebrow mb-2 border-t border-warm/70 pt-6">Earlier and smaller projects</p>
      <ul class="border-t border-warm/70">
        {minor.map((p) => <ProjectRow project={p} />)}
      </ul>
    </Container>
  )}
</BaseLayout>
