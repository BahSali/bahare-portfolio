---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Container from '~/components/Container.astro';
import ProjectCard from '~/components/ProjectCard.astro';
import { projects } from '~/data/projects';
import { projectCards } from '~/data/cards';

// The card with tier 'lead' is shown larger; the rest follow in the shared order.
const leadSlug = projects.find((p) => p.tier === 'lead')!.slug;
const leadCard = projectCards.find((c) => c.slug === leadSlug)!;
const otherCards = projectCards.filter((c) => c.slug !== leadSlug);
const tones = ['warm', 'sage', 'warm'] as const;
---
<BaseLayout title="Projects" description="Projects in machine learning, spatiotemporal modeling and optimization.">
  <Container class="pt-8 sm:pt-10">
    <div>
      <div>
        <h1 class="font-display-tight text-[clamp(1.75rem,3.2vw,2.5rem)] font-light" style="line-height:1.08">Projects</h1>
      </div>

    </div>
  </Container>

  <Container class="pt-6 sm:pt-8">
    <ProjectCard item={leadCard} variant="lead" tone="sage" />
  </Container>

  <Container class="pt-8 sm:pt-10">
    <p class="eyebrow mb-5 border-t border-warm/70 pt-4">More projects</p>
    <div class="grid gap-6 md:grid-cols-3 md:gap-6">
      {otherCards.map((item, i) => <ProjectCard item={item} tone={tones[i % tones.length]} compactMobile />)}
    </div>
  </Container>
</BaseLayout>
