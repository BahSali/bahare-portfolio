---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Container from '~/components/Container.astro';
import ImagePlaceholder from '~/components/ImagePlaceholder.astro';
import PageHeader from '~/components/PageHeader.astro';
import Placeholder from '~/components/Placeholder.astro';
import Timeline from '~/components/Timeline.astro';
import { timelineItems } from '~/lib/timeline';
import { experience } from '~/data/experience';
import { emeralds } from '~/data/emeralds';
import { getProject } from '~/data/projects';

const industry = experience.find((e) => e.lane === 'industry');
const relatedProject = getProject(emeralds.relatedProject);
const tones = ['sage', 'warm', 'sage'] as const;
---
<BaseLayout title="Experience" description="Academic and industrial experience, including the EU Horizon Europe EMERALDS project and enterprise databases and ERP systems.">
  <PageHeader eyebrow="Experience" title="Academic and professional journey">
    <p>From undergraduate studies to a PhD, alongside industrial work with enterprise databases and ERP systems.</p>
    <p class="mt-3 text-sm"><a href="#emeralds" class="link-line">EMERALDS</a> · <a href="#industry" class="link-line">Industry</a></p>
  </PageHeader>

  <Container class="pt-10">
    <Timeline items={timelineItems} />
  </Container>

  <!-- EMERALDS -->
  <section id="emeralds" aria-labelledby="emeralds-h" class="mt-section-sm scroll-mt-16 bg-teal text-paper">
    <Container class="py-12 sm:py-16">
      <div class="grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-6">
          <p class="eyebrow !text-sage">{emeralds.eyebrow}</p>
          <h2 id="emeralds-h" class="font-display-tight mt-3 text-3xl font-light sm:text-[2.1rem]">{emeralds.title}</h2>
          <p class="mt-4 max-w-xl text-lg text-paper/90">{emeralds.body}</p>
          <p class="mt-3 max-w-xl text-paper/85">
            {emeralds.relation}
            {relatedProject && <> <a href={`/projects/${relatedProject.slug}`} class="link-line hover:!text-sage">See the PhD project →</a></>}
          </p>

          <ul class="mt-8 divide-y divide-paper/20 border-y border-paper/20">
            {emeralds.focus.map((f) => <li class="py-3 font-display text-lg" style="line-height:1.3">{f}</li>)}
          </ul>

          <p class="mt-6 text-sm text-paper/85">
            {emeralds.link
              ? <a href={emeralds.link.href} class="link-line hover:!text-sage">{emeralds.link.label} →</a>
              : <span>[Official project link to be added]</span>}
          </p>
          <div class="mt-3 text-sm text-paper/85">
            {emeralds.deliverables.length
              ? <ul class="space-y-1">{emeralds.deliverables.map((d) => <li><a href={d.href} class="link-line hover:!text-sage">{d.label}</a></li>)}</ul>
              : <span>[Selected public deliverables to be added]</span>}
          </div>
        </div>

        <div class="lg:col-span-6">
          <p class="eyebrow mb-3 !text-sage">Presentations and project material</p>
          <div class="grid grid-cols-2 gap-3">
            {emeralds.gallery.map((g, i) => (
              <ImagePlaceholder
                src={g.src}
                alt={g.alt}
                label={g.placeholderLabel}
                tone={tones[i % tones.length]}
                ratio={i === 0 ? 'aspect-[16/10]' : 'aspect-[4/3]'}
                class={i === 0 ? 'col-span-2' : ''}
              />
            ))}
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Industry -->
  {industry && (
    <section id="industry" aria-labelledby="industry-h" class="scroll-mt-16 pt-section-sm">
      <Container>
        <div class="grid gap-8 border-t border-warm/70 pt-8 lg:grid-cols-12 lg:gap-10">
          <div class="lg:col-span-4">
            <p class="eyebrow mb-3">Professional experience · Industry</p>
            <h2 id="industry-h" class="font-display-tight text-2xl font-light sm:text-[1.9rem]" style="line-height:1.1">{industry.title}</h2>
          </div>
          <div class="lg:col-span-7 lg:col-start-6">
            <dl class="grid gap-x-8 gap-y-3 border-b border-warm/70 pb-5 text-sm sm:grid-cols-3">
              <div><dt class="eyebrow mb-1">Employer</dt><dd>{industry.organization ?? <Placeholder>Employer to be added</Placeholder>}</dd></div>
              <div><dt class="eyebrow mb-1">Role</dt><dd>{industry.role ?? <Placeholder>Role to be added</Placeholder>}</dd></div>
              <div><dt class="eyebrow mb-1">Period</dt><dd><Placeholder>Dates to be added</Placeholder></dd></div>
            </dl>
            <p class="mt-5 text-lg text-ink-soft">{industry.summary}</p>
            <ul class="mt-6 grid gap-x-8 sm:grid-cols-2">
              {industry.topics.map((t) => <li class="border-t border-warm/70 py-3 font-display text-lg">{t}</li>)}
            </ul>
            <p class="mt-4 text-sm"><a href="/about#skills" class="link-line">Skills by category →</a></p>
          </div>
        </div>
      </Container>
    </section>
  )}
</BaseLayout>
